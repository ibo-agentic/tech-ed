<!DOCTYPE html>
<html lang="bn" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Sheelbi — NCTB AI Tutor</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%230d0f14'/><line x1='50' y1='50' x2='54' y2='12' stroke='%234d7fff' stroke-width='14' stroke-linecap='round'/><line x1='50' y1='50' x2='88' y2='44' stroke='url(%23gb)' stroke-width='14' stroke-linecap='round'/><line x1='50' y1='50' x2='20' y2='22' stroke='%23f0a030' stroke-width='14' stroke-linecap='round'/><line x1='50' y1='50' x2='16' y2='62' stroke='%23f0a030' stroke-width='14' stroke-linecap='round'/><line x1='50' y1='50' x2='68' y2='82' stroke='%239b6fd4' stroke-width='14' stroke-linecap='round'/><circle cx='50' cy='50' r='9' fill='%230d0f14'/><circle cx='50' cy='50' r='6' fill='%23f0a030'/><defs><linearGradient id='gb' x1='0%25' y1='0%25' x2='100%25' y2='0%25'><stop offset='0%25' stop-color='%234d7fff'/><stop offset='100%25' stop-color='%239b6fd4'/></linearGradient></defs></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Noto+Sans+Bengali:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <style>
    /* ═══════════════════════════════════════════════════════
       CSS VARIABLES
    ═══════════════════════════════════════════════════════ */
    :root {
      --bg:         #0f1419;
      --bg2:        #1a1f2e;
      --bg3:        #252d3f;
      --bg4:        #2f3a52;
      --bg5:        #3a465f;
      --input-bg:   #1a1f2e;
      --border:     #2f3a52;
      --border2:    #3a465f;
      --border3:    #4a5a75;
      --text:       #f5f7fc;
      --text2:      #a0aec0;
      --text3:      #6b7a94;
      --green:      #10b981;
      --green2:     #059669;
      --green3:     #047857;
      --green-glow: rgba(16,185,129,.12);
      --green-bg:   rgba(16,185,129,.06);
      --amber:      #f59e0b;
      --amber-bg:   rgba(245,158,11,.06);
      --blue:       #3b82f6;
      --blue-bg:    rgba(59,130,246,.06);
      --purple:     #8b5cf6;
      --accent:     #6366f1;
      --danger:     #ef4444;
      --user-bubble:#1e3a5f;
      --left-w:     260px;
      --right-w:    280px;
      --radius:     16px;
      --radius-sm:  12px;
      --radius-xs:  8px;
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      --safe-top:    env(safe-area-inset-top, 0px);
    }
    [data-theme="light"] {
      --bg:#f0f2f7; --bg2:#f8f9fd; --bg3:#edf0f7; --bg4:#e4e8f2; --bg5:#dde2ee;
      --input-bg:#f4f5fb; --border:#dde2ee; --border2:#cdd3e4; --border3:#bbc3d8;
      --text:#141720; --text2:#5a6480; --text3:#9099b4;
      --green:#0f9e6f; --green2:#0c8a5e; --green3:#097550;
      --green-glow:rgba(15,158,111,.12); --green-bg:rgba(15,158,111,.07);
      --amber:#c07825; --amber-bg:rgba(192,120,37,.07);
      --blue:#3a6de8; --blue-bg:rgba(58,109,232,.07);
      --purple:#7a55b8; --accent:#4a5aee; --user-bubble:#dfe5ff; --danger:#c0394a;
    }

    *{margin:0;padding:0;box-sizing:border-box;}
    html{height:100%;overscroll-behavior:none;}
    body{
      font-family:'Sora','Noto Sans Bengali',sans-serif;
      background:var(--bg); color:var(--text);
      height:100dvh; display:flex; flex-direction:column;
      -webkit-font-smoothing:antialiased; overflow:hidden; width:100%;
    }

    /* ═══════════════════════════════════════════════════════
       HEADER
    ═══════════════════════════════════════════════════════ */
    header{
      height:64px; background:var(--bg); border-bottom:1px solid var(--border);
      display:flex; align-items:center; justify-content:space-between;
      padding:0 28px; padding-top:var(--safe-top);
      position:relative; z-index:50; flex-shrink:0; gap:16px;
      backdrop-filter:blur(10px);
      background:rgba(15,20,25,.95);
    }
    header::after{
      content:''; position:absolute; bottom:0; left:0; right:0; height:1px;
      background:linear-gradient(90deg,transparent 0%,rgba(59,130,246,.3) 25%,rgba(139,92,246,.3) 75%,transparent 100%);
      opacity:1;
    }
    .header-left{display:flex;align-items:center;gap:10px;flex-shrink:0;}
    .logo-mark{width:32px;height:32px;border-radius:9px;background:var(--bg3);border:1px solid var(--border2);display:flex;align-items:center;justify-content:center;flex-shrink:0;padding:4px;}
    .logo-text h1{font-size:16px;font-weight:800;letter-spacing:-.5px;line-height:1.1; background:linear-gradient(135deg,var(--blue),var(--purple)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;}
    .logo-text p{font-size:11px;color:var(--text3); font-weight:500;}
    .header-center{display:flex;align-items:center;gap:10px;}
    .deepti-pill{\n      display:flex;align-items:center;gap:8px;background:rgba(59,130,246,.08);border:1px solid rgba(59,130,246,.2);border-radius:24px;padding:6px 14px 6px 8px;white-space:nowrap;cursor:default;user-select:none; transition:all .3s;\n    }\n    .deepti-pill:hover{\n      background:rgba(59,130,246,.12);\n      border-color:rgba(59,130,246,.3);\n    }
    .deepti-avatar{width:20px;height:20px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--purple));display:flex;align-items:center;justify-content:center;font-size:8.5px;font-weight:700;color:#fff;}
    .deepti-name{font-size:11.5px;font-weight:600;}
    .deepti-dot{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 5px var(--green);animation:pulse-dot 2.5s ease-in-out infinite;}
    @keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.75)}}
    @keyframes pulse-fast{0%,100%{opacity:1;transform:scale(1.1)}50%{opacity:.55;transform:scale(.85)}}
    .header-right{display:flex;align-items:center;gap:7px;flex-shrink:0;}
    .hdr-icon-btn{width:30px;height:30px;background:var(--bg3);border:1px solid var(--border2);border-radius:var(--radius-sm);color:var(--text2);font-size:13px;cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;}
    .hdr-icon-btn:hover{border-color:var(--amber);color:var(--amber);}
    .hdr-btn-login{height:36px;padding:0 18px;background:var(--green);border:none;border-radius:var(--radius-sm);color:#fff;font-size:13px;font-weight:600;font-family:'Sora',sans-serif;cursor:pointer;transition:all .25s; box-shadow:0 2px 8px rgba(16,185,129,.2);}
    .hdr-btn-login:hover{background:var(--green2);transform:translateY(-2px); box-shadow:0 4px 12px rgba(16,185,129,.3);}
    .hdr-btn-new{height:36px;padding:0 20px;background:linear-gradient(135deg,var(--blue),var(--purple));border:none;border-radius:var(--radius-sm);color:#fff;font-size:13px;font-weight:600;font-family:'Sora',sans-serif;cursor:pointer;transition:all .25s;display:flex;align-items:center;gap:6px; box-shadow:0 2px 12px rgba(59,130,246,.3);}
    .hdr-btn-new:hover{transform:translateY(-2px); box-shadow:0 6px 20px rgba(59,130,246,.4);}
    .hamburger-btn{width:30px;height:30px;background:var(--bg3);border:1px solid var(--border2);border-radius:var(--radius-sm);color:var(--text2);font-size:14px;cursor:pointer;transition:all .15s;display:none;align-items:center;justify-content:center;}
    .hamburger-btn:hover,.hamburger-btn.active{border-color:var(--green);color:var(--green);}

    /* ═══════════════════════════════════════════════════════
       3-COLUMN LAYOUT
    ═══════════════════════════════════════════════════════ */
    .app-layout{flex:1;min-height:0;display:flex;overflow:hidden;}

    /* ═══════════════════════════════════════════════════════
       LEFT SIDEBAR
    ═══════════════════════════════════════════════════════ */
    .left-sidebar{
      width:var(--left-w); background:var(--bg2); border-right:1px solid var(--border);
      display:flex; flex-direction:column; flex-shrink:0; overflow:hidden;
      transition:width .25s ease;
    }
    .left-sidebar.minimized{width:70px;}
    .left-sidebar.minimized .sb-profile-row{flex-direction:column; align-items:center; margin-bottom:4px;}
    .left-sidebar.minimized .sb-label,
    .left-sidebar.minimized .sb-text,
    .left-sidebar.minimized .folder-name,
    .left-sidebar.minimized .sb-nav-item span:not(.sb-nav-icon),
    .left-sidebar.minimized .logo-text,
    .left-sidebar.minimized .sb-user-info,
    .left-sidebar.minimized .sb-folders-header,
    .left-sidebar.minimized .sb-upgrade-btn,
    .left-sidebar.minimized .sb-upgrade-text,
    .left-sidebar.minimized .sb-profile-info,
    .left-sidebar.minimized .sb-footer,
    .left-sidebar.minimized .sidebar-profile-menu {display:none;}
    .left-sidebar.minimized .sb-profile{align-items:center;justify-content:center;padding:8px;}
    .left-sidebar.minimized .sb-user-avatar{width:40px;height:40px;}
    .left-sidebar.minimized .sb-nav{padding:4px;gap:0;}
    .left-sidebar.minimized .sb-nav-item{width:auto;justify-content:center;padding:8px;}
    .left-sidebar.minimized .sb-folders-list{padding:4px;}
    .left-sidebar.minimized .folder-item{justify-content:center;padding:8px;width:auto;}
    .left-sidebar.minimized .folder-icon{margin:0;}
    .left-sidebar.minimized .folder-count{display:none;}
    .sb-minimize-btn{
      background:none; border:none; color:var(--text2); font-size:16px;
      cursor:pointer; padding:0; display:flex; align-items:center; justify-content:center;
      transition:color .15s;
    }
    .sb-minimize-btn:hover{color:var(--text);}
    .sb-profile{padding:12px 12px 10px;border-bottom:1px solid var(--border);display:flex;flex-direction:column;gap:7px;}
    .sb-profile-row{display:flex;align-items:center;gap:9px;}
    .sb-user-avatar{width:32px;height:32px;border-radius:9px;flex-shrink:0;background:linear-gradient(135deg,var(--blue),var(--purple));display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff;}
    .sb-user-info{flex:1;min-width:0;}
    .sb-user-name{font-size:12.5px;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .sb-user-meta{display:flex;align-items:center;gap:4px;margin-top:2px;}
    .sb-class-badge{font-size:9.5px;font-weight:700;padding:1px 6px;border-radius:8px;background:var(--blue-bg);color:var(--blue);border:1px solid rgba(77,127,255,.2);}
    .sb-plan-badge{font-size:9.5px;font-weight:700;padding:1px 6px;border-radius:8px;background:var(--green-bg);color:var(--green);border:1px solid rgba(34,197,140,.2);}
    .sb-plan-badge.pro{background:var(--amber-bg);color:var(--amber);border-color:rgba(240,160,48,.2);}
    .streak-compact{display:flex;align-items:center;gap:6px;background:var(--amber-bg);border:1px solid rgba(240,160,48,.18);border-radius:var(--radius-xs);padding:5px 8px;}
    .streak-compact-num{font-size:12px;font-weight:700;color:var(--amber);}
    .streak-compact-label{font-size:10px;color:var(--text2);font-family:'Noto Sans Bengali','Sora',sans-serif;}

    /* Nav links */
    .sb-nav{padding:6px 8px;border-bottom:1px solid var(--border);display:flex;flex-direction:column;gap:2px;}
    .sb-nav-item{display:flex;align-items:center;gap:8px;padding:7px 9px;border-radius:var(--radius-sm);cursor:pointer;transition:all .13s;border:1px solid transparent;font-size:12px;color:var(--text2);font-family:'Sora',sans-serif;background:transparent;text-align:left;width:100%;}
    .sb-nav-item:hover{background:var(--bg3);color:var(--text);border-color:var(--border2);}
    .sb-nav-item.active{background:var(--bg4);color:var(--green);border-color:var(--border3);font-weight:600;}
    .sb-nav-item.active .sb-nav-icon{color:var(--green);}
    .sb-nav-icon{font-size:14px;width:18px;text-align:center;flex-shrink:0;}

    /* Folders */
    .sb-folders-section{border-bottom:1px solid var(--border);flex-shrink:0;}
    .sb-folders-header{display:flex;align-items:center;justify-content:space-between;padding:8px 12px 6px;}
    .sb-folders-label{font-size:9.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--text3);font-weight:600;}
    .sb-folder-add-btn{width:18px;height:18px;background:var(--bg3);border:1px solid var(--border2);border-radius:4px;color:var(--text3);font-size:11px;cursor:pointer;transition:all .13s;display:flex;align-items:center;justify-content:center;}
    .sb-folder-add-btn:hover{border-color:var(--green);color:var(--green);}
    .sb-folders-list{padding:0 8px 8px;display:flex;flex-direction:column;gap:2px;}
    .folder-item{display:flex;align-items:center;gap:7px;padding:6px 8px;border-radius:var(--radius-xs);cursor:pointer;transition:all .13s;position:relative;border:1px solid transparent;}
    .folder-item:hover{background:var(--bg3);border-color:var(--border2);}
    .folder-item.active{background:var(--bg4);border-color:var(--border3);}
    .folder-item.active::before{content:'';position:absolute;left:0;top:20%;bottom:20%;width:2px;background:var(--blue);border-radius:0 2px 2px 0;}
    .folder-icon{font-size:13px;flex-shrink:0;}
    .folder-name{font-size:11.5px;color:var(--text2);flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .folder-item.active .folder-name{color:var(--text);}
    .folder-count{font-size:9px;background:var(--bg5);color:var(--text3);padding:1px 5px;border-radius:8px;flex-shrink:0;}
    .folder-item.active .folder-count{background:var(--blue-bg);color:var(--blue);}
    .folder-delete-btn{background:none;border:none;color:var(--text3);cursor:pointer;font-size:9px;padding:1px 3px;border-radius:3px;opacity:0;transition:all .13s;flex-shrink:0;}
    .folder-item:hover .folder-delete-btn{opacity:1;}
    .folder-delete-btn:hover{color:var(--danger);}
    .folder-input-row{display:none;padding:4px 8px 8px;gap:5px;}
    .folder-input-row.visible{display:flex;}
    .folder-input{flex:1;background:var(--input-bg);border:1px solid var(--blue);border-radius:var(--radius-xs);padding:5px 8px;color:var(--text);font-size:11.5px;font-family:'Sora',sans-serif;outline:none;}
    .folder-input-confirm{background:var(--blue);border:none;border-radius:var(--radius-xs);color:#fff;font-size:11px;padding:4px 9px;cursor:pointer;font-family:'Sora',sans-serif;white-space:nowrap;}

    .sb-new-chat-btn{
      margin:12px 10px 8px;
      background:linear-gradient(135deg,var(--blue),var(--purple));
      border:none;
      border-radius:var(--radius-sm);
      padding:10px 16px;
      color:#fff;
      font-size:13px;
      font-weight:600;
      font-family:'Sora',sans-serif;
      cursor:pointer;
      transition:all .25s;
      text-align:center;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      width:calc(100% - 20px);
      box-shadow:0 2px 8px rgba(59,130,246,.2);
    }
    .sb-new-chat-btn:hover{
      opacity:.9;
      transform:translateY(-2px);
      box-shadow:0 4px 12px rgba(59,130,246,.3);
    }
    .sb-search{padding:0 10px 7px;}
    .sb-search-inner{display:flex;align-items:center;gap:7px;background:var(--bg3);border:1px solid var(--border2);border-radius:var(--radius-sm);padding:5px 9px;}
    .sb-search-inner input{flex:1;background:transparent;border:none;outline:none;font-size:11px;color:var(--text);font-family:'Sora',sans-serif;}
    .sb-search-inner input::placeholder{color:var(--text3);}
    .sb-chats-area{flex:1;overflow-y:auto;padding:0 0 6px;}
    .sb-chats-area::-webkit-scrollbar{width:3px;}
    .sb-chats-area::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px;}
    .sb-section-label{font-size:9.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--text3);padding:7px 12px 3px;font-weight:600;}
    .chat-item{display:flex;align-items:center;gap:7px;padding:6px 9px;border-radius:var(--radius-sm);cursor:pointer;transition:background .13s;margin:1px 5px;position:relative;}
    .chat-item:hover{background:var(--bg3);}
    .chat-item.active{background:var(--bg4);}
    .chat-item.active::before{content:'';position:absolute;left:0;top:20%;bottom:20%;width:3px;background:var(--green);border-radius:0 2px 2px 0;}
    .chat-subj-icon{width:22px;height:22px;border-radius:5px;background:var(--bg5);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:10px;}
    .chat-item-info{flex:1;min-width:0;}
    .chat-item-title{font-size:11px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .chat-item-sub{font-size:9.5px;color:var(--text3);margin-top:1px;}
    .chat-item-time{font-size:9.5px;color:var(--text3);margin-top:1px;}
    .chat-item.active .chat-item-title{color:var(--green);}
    .chat-delete-btn{background:none;border:none;color:var(--text3);cursor:pointer;padding:2px 3px;border-radius:4px;font-size:9px;opacity:0;transition:all .13s;flex-shrink:0;}
    .chat-item:hover .chat-delete-btn{opacity:1;}
    .chat-delete-btn:hover{color:var(--danger);}
    .sidebar-empty{text-align:center;padding:20px 12px;color:var(--text3);font-size:11px;line-height:2;}
    .sb-upgrade-btn{margin:0 10px 10px;background:linear-gradient(135deg,var(--amber-bg),rgba(240,160,48,.14));border:1px solid rgba(240,160,48,.25);border-radius:var(--radius-sm);padding:7px 9px;display:flex;align-items:center;gap:7px;cursor:pointer;transition:all .15s;}
    .sb-upgrade-btn:hover{border-color:var(--amber);}
    .sb-upgrade-icon{font-size:13px;flex-shrink:0;}
    .sb-upgrade-text{flex:1;}
    .sb-upgrade-title{font-size:11px;font-weight:700;color:var(--amber);}
    .sb-upgrade-sub{font-size:9.5px;color:var(--text2);margin-top:1px;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .sb-footer{border-top:1px solid var(--border);padding:7px 10px;flex-shrink:0;position:relative;}
    .sb-profile-btn{display:none;width:100%;background:transparent;border:none;border-radius:var(--radius-sm);padding:5px 7px;cursor:pointer;align-items:center;gap:9px;transition:background .15s;font-family:'Sora',sans-serif;text-align:left;}
    .sb-profile-btn:hover,.sb-profile-btn.open{background:var(--bg3);}
    .sb-avatar{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--purple));display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;flex-shrink:0;}
    .sb-profile-info{flex:1;min-width:0;}
    .sb-profile-name{font-size:11.5px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .sb-profile-email{font-size:9.5px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px;}
    .sb-chevron{font-size:9px;color:var(--text3);flex-shrink:0;transition:transform .2s;}
    .sb-profile-btn.open .sb-chevron{transform:rotate(180deg);}
    .sidebar-profile-menu{display:none;position:absolute;bottom:calc(100% + 6px);left:7px;right:7px;background:var(--bg2);border:1px solid var(--border2);border-radius:var(--radius);box-shadow:0 -16px 40px rgba(0,0,0,.6);z-index:200;overflow:hidden;}
    .sidebar-profile-menu.open{display:block;animation:popUp .2s cubic-bezier(.34,1.56,.64,1) both;}
    @keyframes popUp{from{opacity:0;transform:translateY(8px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
    .spm-header{padding:11px;background:var(--bg3);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:9px;}
    .spm-avatar{width:32px;height:32px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,var(--blue),var(--purple));display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff;}
    .spm-info{overflow:hidden;flex:1;}
    .spm-name{font-size:12px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .spm-email{font-size:10px;color:var(--text2);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .spm-plan-badge{font-size:9px;font-weight:700;padding:1px 7px;border-radius:8px;background:var(--green-bg);color:var(--green);border:1px solid rgba(34,197,140,.2);margin-top:3px;display:inline-block;text-transform:uppercase;letter-spacing:.4px;}
    .spm-plan-badge.pro{background:var(--amber-bg);color:var(--amber);border-color:rgba(240,160,48,.25);}
    .spm-body{padding:3px 0;}
    .spm-item{display:flex;align-items:center;gap:9px;width:100%;padding:7px 12px;background:transparent;border:none;color:var(--text2);font-size:12px;font-family:'Sora',sans-serif;cursor:pointer;text-align:left;transition:all .13s;}
    .spm-item:hover{background:var(--bg3);color:var(--text);}
    .spm-item-icon{width:14px;text-align:center;font-size:11px;flex-shrink:0;}
    .spm-divider{height:1px;background:var(--border);margin:3px 0;}
    .spm-item.danger{color:var(--danger);}
    .spm-item.danger:hover{background:rgba(224,90,106,.08);}
    .sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:39;backdrop-filter:blur(3px);}
    .sidebar-overlay.visible{display:block;}

    /* ═══════════════════════════════════════════════════════
       MAIN CONTENT AREA — shared wrapper
    ═══════════════════════════════════════════════════════ */
    .main-content{flex:1;min-width:0;display:flex;flex-direction:column;height:100%;overflow:hidden;position:relative;border-right:1px solid var(--border);}

    /* ═══════════════════════════════════════════════════════
       HOME VIEW (web dashboard)
    ═══════════════════════════════════════════════════════ */
    #home-view{
      flex:1; min-height:0; overflow-y:auto; padding:24px 24px 20px;
      display:flex; flex-direction:column; gap:18px;
    }
    #home-view::-webkit-scrollbar{width:4px;}
    #home-view::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px;}

    /* Greeting card */
    .home-greeting-card{
      background:linear-gradient(135deg,rgba(59,130,246,.08) 0%,rgba(139,92,246,.08) 100%);
      border:1px solid rgba(59,130,246,.15); border-radius:var(--radius);
      padding:28px 32px; display:flex; align-items:center; gap:28px;
      position:relative; overflow:hidden; animation:fadeUp .4s ease both;
      box-shadow:0 4px 20px rgba(59,130,246,.08);
    }
    .home-greeting-card::before{
      content:''; position:absolute; top:0; left:0; right:0; height:1px;
      background:linear-gradient(90deg,transparent 0%,rgba(59,130,246,.4) 50%,transparent 100%);
    }
    .greeting-avatar{
      width:80px; height:80px; border-radius:20px; flex-shrink:0;
      background:linear-gradient(135deg,var(--blue),var(--purple));
      display:flex; align-items:center; justify-content:center; font-size:40px;
      box-shadow:0 8px 24px rgba(59,130,246,.3);
    }
    .greeting-body{flex:1; min-width:0;}
    .greeting-title{font-size:15px; font-weight:700; color:var(--text); margin-bottom:8px; font-family:'Noto Sans Bengali','Sora',sans-serif; line-height:1.6;}
    .greeting-sub{font-size:12px; color:var(--text2); font-family:'Noto Sans Bengali','Sora',sans-serif; line-height:1.8;}
    .greeting-cta{
      margin-top:14px;
      display:inline-flex; align-items:center; gap:7px;
      background:linear-gradient(135deg,var(--blue),var(--purple));
      border:none; border-radius:var(--radius-sm);
      color:#fff; font-size:12.5px; font-weight:700;
      font-family:'Sora',sans-serif; padding:9px 18px;
      cursor:pointer; transition:all .15s;
    }
    .greeting-cta:hover{opacity:.88; transform:translateY(-1px);}
    .greeting-ssc-badge{
      position:absolute; top:14px; right:16px;
      background:var(--bg3); border:1px solid var(--border2);
      border-radius:20px; padding:4px 10px;
      font-size:10px; color:var(--text2); white-space:nowrap;
    }
    .greeting-ssc-badge span{color:var(--blue); font-weight:700;}

    /* Stats row */
    .home-stats-row{display:grid; grid-template-columns:repeat(3,1fr); gap:10px; animation:fadeUp .45s ease both;}
    .stat-card{
      background:linear-gradient(135deg,var(--bg3),var(--bg2)); border:1px solid var(--border2);
      border-radius:var(--radius-sm); padding:22px 20px; text-align:center;
      transition:all .3s; box-shadow:0 2px 8px rgba(0,0,0,.2);
    }
    .stat-card:hover{
      border-color:var(--border3);
      box-shadow:0 4px 16px rgba(0,0,0,.3);
      transform:translateY(-4px);
    }
    .stat-value{font-size:32px; font-weight:800; line-height:1.1;}
    .stat-label{font-size:12px; color:var(--text2); margin-top:8px; font-family:'Noto Sans Bengali','Sora',sans-serif; font-weight:500;}
    .stat-sub{font-size:10px; color:var(--text3); margin-top:3px;}

    /* Focus card */
    .home-focus-card{
      background:linear-gradient(135deg,rgba(245,158,11,.08) 0%,rgba(34,197,140,.08) 100%);
      border:1px solid rgba(245,158,11,.15); border-radius:var(--radius);
      padding:28px 32px; animation:fadeUp .5s ease both;
      box-shadow:0 4px 20px rgba(245,158,11,.08);
    }
    .focus-label-row{display:flex; align-items:center; gap:8px; margin-bottom:10px;}
    .focus-badge{
      font-size:10px; font-weight:700; padding:4px 10px; border-radius:10px;
      background:var(--amber-bg); color:var(--amber);
      border:1px solid rgba(245,158,11,.25); letter-spacing:.04em; text-transform:uppercase;
    }
    .focus-badge-label{font-size:10px; color:var(--text3);}
    .focus-title{font-size:24px; font-weight:800; color:var(--text); margin-bottom:8px;}
    .focus-sub{font-size:13px; color:var(--text2); margin-bottom:16px; font-family:'Noto Sans Bengali','Sora',sans-serif; line-height:1.6;}
    .focus-bar-wrap{display:flex; align-items:center; gap:14px;}
    .focus-bar-bg{flex:1; height:8px; background:var(--border2); border-radius:8px; overflow:hidden;}
    .focus-bar{height:100%; border-radius:8px; background:linear-gradient(90deg,var(--amber),var(--green)); transition:width .6s cubic-bezier(.25,.46,.45,.94);}
    .focus-pct{font-size:12px; font-weight:700; color:var(--blue); flex-shrink:0;}
    .focus-cta{
      margin-top:16px;
      display:inline-flex; align-items:center; gap:7px;
      background:linear-gradient(135deg,var(--blue),var(--purple)); border:none;
      border-radius:var(--radius-sm); color:#fff;
      font-size:13px; font-weight:600; font-family:'Sora',sans-serif;
      padding:10px 18px; cursor:pointer; transition:all .15s;
    }
    .focus-cta:hover{opacity:.88; transform:translateY(-1px);}

    /* Recent chats section */
    .home-section-title{
      font-size:11px; text-transform:uppercase; letter-spacing:.08em;
      color:var(--text3); font-weight:700; margin-bottom:8px;
    }
    .recent-chat-list{display:flex; flex-direction:column; gap:5px; animation:fadeUp .55s ease both;}
    .recent-chat-item{
      display:flex; align-items:center; gap:12px;
      background:var(--bg2); border:1px solid var(--border2);
      border-radius:var(--radius-sm); padding:14px 18px;
      cursor:pointer; transition:all .25s;
    }
    .recent-chat-item:hover{
      border-color:var(--blue);
      background:var(--bg3);
      transform:translateX(4px);
      box-shadow:0 4px 12px rgba(59,130,246,.15);
    }
    .rc-dot{width:9px; height:9px; border-radius:50%; flex-shrink:0;}
    .rc-dot.blue{background:var(--blue);}
    .rc-dot.amber{background:var(--amber);}
    .rc-dot.green{background:var(--green);}
    .rc-dot.purple{background:var(--purple);}
    .rc-info{flex:1; min-width:0;}
    .rc-title{font-size:13px; font-weight:600; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .rc-folder{font-size:10px; color:var(--text3); margin-top:3px;}
    .rc-time{font-size:10px; color:var(--text3); flex-shrink:0; margin-right:8px;}
    .rc-arrow{font-size:12px; color:var(--text3); flex-shrink:0; opacity:0; transition:opacity .13s;}
    .recent-chat-item:hover .rc-arrow{opacity:1;}

    @keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

    /* ═══════════════════════════════════════════════════════
       CHAT VIEW
    ═══════════════════════════════════════════════════════ */
    #chat-view{flex:1;min-height:0;display:none;flex-direction:column;overflow:hidden;}
    #chat-view.active{display:flex;}

    #chat-box{
      flex:1; min-height:0; overflow-y:auto; overflow-x:hidden;
      padding:24px 20px 12px; display:flex; flex-direction:column;
      gap:18px; scroll-behavior:auto; -webkit-overflow-scrolling:touch;
      overscroll-behavior-y:contain;
    }
    #chat-box::-webkit-scrollbar{width:4px;}
    #chat-box::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px;}

    /* welcome */
    .welcome{text-align:center;margin:0 auto;padding:32px 20px 16px;animation:fadeUp .5s ease both;display:flex;flex-direction:column;align-items:center;max-width:600px;width:100%;}
    .welcome-glow{position:relative;margin-bottom:18px;}
    .welcome-glow::before{content:'';position:absolute;inset:-20px;background:radial-gradient(ellipse,rgba(77,127,255,.12) 0%,transparent 70%);border-radius:50%;pointer-events:none;}
    .welcome-icon{width:72px;height:72px;border-radius:20px;background:var(--bg3);border:1px solid var(--border2);display:flex;align-items:center;justify-content:center;padding:10px;position:relative;}
    .welcome h2{font-size:21px;font-weight:700;margin-bottom:7px;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .welcome .welcome-sub{font-size:13px;color:var(--text2);margin-bottom:8px;line-height:1.9;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .welcome .welcome-img-note{font-size:11px;color:var(--green);margin-bottom:24px;}
    .subject-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;max-width:480px;width:100%;margin-bottom:18px;}
    .subj-card{background:var(--bg2);border:1px solid var(--border2);border-radius:var(--radius);padding:12px 10px;cursor:pointer;transition:all .18s;text-align:left;}
    .subj-card:hover{border-color:var(--blue);background:var(--blue-bg);transform:translateY(-2px);}
    .subj-card-icon{font-size:17px;margin-bottom:5px;}
    .subj-card-title{font-size:11.5px;font-weight:600;color:var(--text);margin-bottom:2px;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .subj-card-example{font-size:10.5px;color:var(--text2);line-height:1.5;font-family:'Noto Sans Bengali','Sora',sans-serif;}

    /* messages */
    .message{display:flex;gap:9px;align-items:flex-start;animation:fadeUp .3s ease both;}
    .message.user{flex-direction:row-reverse;}
    .avatar{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;}
    .user .avatar{background:linear-gradient(135deg,var(--blue),var(--purple));font-size:10px;font-weight:700;color:#fff;}
    .bot .avatar{background:var(--bg3);border:1px solid var(--border2);padding:4px;}
    .bot-col{flex:1;min-width:0;display:flex;flex-direction:column;}
    .bubble{border-radius:var(--radius);word-break:break-word;}
    .bot .bubble{background:var(--bg2);border:1px solid var(--border);color:var(--text);border-top-left-radius:3px;padding:14px 18px;font-size:14px;line-height:2;}
    [data-theme="light"] .bot .bubble{background:#fff;box-shadow:0 2px 12px rgba(0,0,0,.06);}
    .bot .bubble p{margin-bottom:10px;}
    .bot .bubble p:last-child{margin-bottom:0;}
    .bot .bubble strong{color:var(--amber);font-weight:600;}
    mark{background:rgba(77,127,255,.1);color:var(--blue);border-radius:3px;padding:1px 5px;font-weight:600;}
    .bot .bubble blockquote{border-left:3px solid var(--blue);background:rgba(77,127,255,.06);border-radius:0 var(--radius-xs) var(--radius-xs) 0;margin:10px 0;padding:10px 14px;}
    .bot .bubble h1,.bot .bubble h2,.bot .bubble h3{font-size:12.5px;font-weight:600;margin:12px 0 7px;color:var(--blue);display:flex;align-items:center;gap:5px;}
    .bot .bubble h3::before{content:'';display:inline-block;width:3px;height:11px;background:linear-gradient(to bottom,var(--blue),var(--purple));border-radius:2px;flex-shrink:0;}
    .bot .bubble ul,.bot .bubble ol{padding-left:0;list-style:none;margin:9px 0;display:flex;flex-direction:column;gap:5px;}
    .bot .bubble li{background:var(--bg3);border:1px solid var(--border);border-left:3px solid var(--blue);border-radius:0 var(--radius-xs) var(--radius-xs) 0;padding:8px 12px;line-height:1.75;transition:background .13s;}
    .bot .bubble li:hover{background:var(--bg4);border-left-color:var(--amber);}
    .user .bubble{max-width:65%;background:var(--user-bubble);border:1px solid var(--border2);color:var(--text);border-top-right-radius:3px;padding:0;overflow:hidden;}
    [data-theme="dark"] .user .bubble{color:#d0e0ff;border-color:rgba(77,127,255,.25);}
    .user .bubble img.sent-image{display:block;width:100%;max-width:240px;max-height:200px;object-fit:cover;}
    .user .bubble .bubble-text{padding:9px 13px;white-space:pre-wrap;display:block;font-size:13px;line-height:1.65;}
    .user .bubble:not(:has(img)){padding:9px 13px;white-space:pre-wrap;font-size:13px;line-height:1.65;}
    .katex-display{margin:.7em auto;text-align:center;overflow-x:auto;scrollbar-width:none;}
    .katex-display::-webkit-scrollbar{display:none;}
    .bot .bubble .katex-display{background:var(--bg3);border-radius:var(--radius-xs);padding:9px 12px;margin:7px 0;border:1px solid var(--border2);position:relative;}
    .math-block-wrap{position:relative;}
    .math-copy-btn{position:absolute;top:5px;right:7px;background:var(--bg4);border:1px solid var(--border2);border-radius:var(--radius-xs);padding:2px 7px;font-size:10px;color:var(--text2);cursor:pointer;font-family:'Sora',sans-serif;opacity:0;transition:opacity .13s;}
    .math-block-wrap:hover .math-copy-btn{opacity:1;}
    .message-actions{display:flex;gap:4px;margin-top:5px;opacity:0;transition:opacity .15s;}
    .message:hover .message-actions{opacity:1;}
    .action-btn{background:var(--bg3);border:1px solid var(--border2);border-radius:var(--radius-xs);padding:2px 8px;font-size:10px;color:var(--text2);cursor:pointer;font-family:'Sora',sans-serif;transition:all .13s;}
    .action-btn:hover{color:var(--green);border-color:var(--green);}
    .action-btn.ok{color:var(--green);border-color:var(--green);}
    .ai-suggestions{display:flex;flex-wrap:wrap;gap:5px;margin-top:10px;padding-top:10px;border-top:1px solid var(--border);}
    .ai-suggestion-btn{background:transparent;border:1px solid var(--border3);border-radius:16px;padding:3px 11px;color:var(--text2);font-size:11px;cursor:pointer;transition:all .15s;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .ai-suggestion-btn:hover{background:var(--blue);border-color:var(--blue);color:#fff;}

    /* quick panel */
    #quick-panel{display:none;position:absolute;bottom:calc(100% + 8px);left:0;right:0;background:var(--bg2);border:1px solid var(--border2);border-radius:var(--radius-sm);padding:8px;flex-wrap:wrap;gap:5px;z-index:50;box-shadow:0 -8px 28px rgba(0,0,0,.35);}
    #quick-panel.open{display:flex;}
    .quick-pill{background:var(--bg3);border:1px solid var(--border2);border-radius:14px;padding:3px 11px;font-size:11px;color:var(--text2);cursor:pointer;font-family:'Noto Sans Bengali','Sora',sans-serif;transition:all .13s;}
    .quick-pill:hover{background:var(--blue);border-color:var(--blue);color:#fff;}

    /* thinking */
    .thinking-bubble{display:flex;flex-direction:column;gap:7px;padding:11px 15px;}
    .thinking-label{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--blue);font-style:italic;}
    .thinking-spinner{width:11px;height:11px;border:2px solid var(--border2);border-top-color:var(--blue);border-radius:50%;animation:spin 1s linear infinite;flex-shrink:0;}
    @keyframes spin{to{transform:rotate(360deg)}}
    .thinking-dots span{width:4px;height:4px;background:var(--text2);border-radius:50%;display:inline-block;animation:bounce 1.2s infinite;margin:0 2px;}
    .thinking-dots span:nth-child(2){animation-delay:.2s}.thinking-dots span:nth-child(3){animation-delay:.4s}
    @keyframes bounce{0%,80%,100%{transform:translateY(0);opacity:.3}40%{transform:translateY(-5px);opacity:1}}
    #scroll-btn{position:absolute;bottom:80px;left:50%;transform:translateX(-50%);background:var(--blue);color:#fff;border:none;border-radius:16px;padding:5px 14px;font-size:11px;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .2s;font-family:'Sora',sans-serif;font-weight:600;z-index:20;white-space:nowrap;}
    #scroll-btn.visible{opacity:1;pointer-events:auto;}

    /* input area */
    #input-area{background:var(--bg2);border-top:1px solid var(--border);padding:10px 16px 12px;padding-bottom:calc(12px + var(--safe-bottom));flex-shrink:0;position:relative;z-index:10;}
    #image-preview-strip{display:none;max-width:100%;margin:0 0 7px;align-items:center;gap:7px;background:var(--bg3);border:1px solid var(--border2);border-radius:var(--radius-sm);padding:5px 9px;}
    #image-preview-strip.visible{display:flex;}
    #preview-thumb{width:36px;height:36px;object-fit:cover;border-radius:5px;border:1px solid var(--border2);flex-shrink:0;}
    #preview-name{flex:1;font-size:11px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    #remove-image-btn{background:transparent;border:none;color:var(--danger);font-size:13px;cursor:pointer;padding:2px;border-radius:4px;transition:background .13s;flex-shrink:0;}
    #remove-image-btn:hover{background:rgba(224,90,106,.1);}
    #input-row{display:flex;gap:5px;align-items:flex-end;position:relative;}
    #file-input{display:none;}
    .inp-icon-btn{width:36px;height:36px;flex-shrink:0;background:var(--bg3);border:1px solid var(--border2);border-radius:var(--radius-sm);color:var(--text2);font-size:14px;cursor:pointer;transition:all .13s;display:flex;align-items:center;justify-content:center;min-width:36px;}
    .inp-icon-btn:hover{border-color:var(--blue);color:var(--blue);}
    #attach-btn.has-image{border-color:var(--green);color:var(--green);background:var(--green-bg);}
    #quick-btn.open{border-color:var(--amber);color:var(--amber);background:var(--amber-bg);}
    #user-input{flex:1;background:var(--input-bg);border:1px solid var(--border2);border-radius:var(--radius-sm);padding:9px 13px;color:var(--text);font-family:'Noto Sans Bengali','Sora',sans-serif;resize:none;outline:none;max-height:120px;transition:border-color .18s,box-shadow .18s;line-height:1.6;font-size:max(14px,16px);}
    #user-input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(77,127,255,.12);}
    #user-input::placeholder{color:var(--text3);}
    #send-btn{width:36px;height:36px;flex-shrink:0;min-width:36px;background:linear-gradient(135deg,var(--blue),var(--purple));border:none;border-radius:var(--radius-sm);color:#fff;font-size:15px;cursor:pointer;transition:all .13s;display:flex;align-items:center;justify-content:center;}
    #send-btn:hover{opacity:.85;transform:translateY(-1px);}
    #send-btn:active{transform:scale(.93);}
    #send-btn:disabled{background:var(--border);cursor:not-allowed;transform:none;}
    .hint-bar{display:flex;align-items:center;justify-content:space-between;margin-top:5px;}
    .hint{font-size:9.5px;color:var(--text3);}
    .char-count{font-size:9.5px;color:var(--text3);}
    .error-bubble{background:rgba(224,90,106,.08);border:1px solid rgba(224,90,106,.2);border-radius:var(--radius-sm);padding:9px 13px;font-size:12.5px;color:var(--danger);display:flex;align-items:center;justify-content:space-between;gap:9px;}

    /* ═══════════════════════════════════════════════════════
       RIGHT SIDEBAR — STUDY TOOLS
    ═══════════════════════════════════════════════════════ */
    .right-sidebar{width:var(--right-w);background:var(--bg2);border-left:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;overflow-y:auto;overflow-x:hidden;}
    .right-sidebar::-webkit-scrollbar{width:3px;}
    .right-sidebar::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px;}
    .rs-section{padding:11px 12px;border-bottom:1px solid var(--border);}
    .rs-section:last-child{border-bottom:none;}
    .rs-title{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--text3);font-weight:600;margin-bottom:9px;}
    .progress-card{background:var(--bg3);border:1px solid var(--border2);border-radius:var(--radius-sm);padding:9px 11px;display:flex;align-items:center;gap:10px;}
    .progress-num{font-size:24px;font-weight:700;color:var(--blue);line-height:1;}
    .progress-label{font-size:11px;font-weight:600;color:var(--text);font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .progress-sub{font-size:10px;color:var(--text2);margin-top:2px;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .streak-badge{background:var(--amber-bg);border:1px solid rgba(240,160,48,.2);border-radius:6px;padding:4px 7px;text-align:center;}
    .streak-badge-num{font-size:12px;font-weight:700;color:var(--amber);}
    .streak-badge-label{font-size:9px;color:var(--text2);white-space:nowrap;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .weak-area-list{display:flex;flex-direction:column;gap:5px;}
    .weak-item{display:flex;align-items:center;gap:8px;background:var(--bg3);border:1px solid var(--border2);border-radius:var(--radius-xs);padding:7px 9px;}
    .weak-icon{font-size:12px;flex-shrink:0;}
    .weak-info{flex:1;min-width:0;}
    .weak-name{font-size:11px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .weak-score{font-size:10px;margin-top:1px;}
    .weak-score.low{color:var(--danger);}
    .weak-score.mid{color:var(--amber);}
    .weak-score.high{color:var(--green);}
    .weak-bar-bg{height:3px;background:var(--border2);border-radius:3px;overflow:hidden;margin-top:3px;}
    .weak-bar{height:100%;border-radius:3px;}

    /* flashcards */
    .flashcard-deck{display:flex;flex-direction:column;gap:5px;}
    .flashcard-empty{text-align:center;padding:16px 8px;color:var(--text3);font-size:11px;line-height:1.8;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .flashcard-empty-icon{font-size:22px;margin-bottom:5px;}
    .fc-card{background:var(--bg3);border:1px solid var(--border2);border-radius:var(--radius-sm);overflow:hidden;cursor:pointer;transition:all .18s;}
    .fc-card:hover{border-color:var(--purple);transform:translateY(-1px);}
    .fc-card.flipped .fc-front{display:none;}
    .fc-card:not(.flipped) .fc-back{display:none;}
    .fc-front,.fc-back{padding:9px 11px;}
    .fc-front{border-left:3px solid var(--blue);}
    .fc-back{border-left:3px solid var(--green);background:var(--bg4);}
    .fc-label{font-size:8.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--text3);font-weight:600;margin-bottom:4px;}
    .fc-front .fc-label{color:var(--blue);}
    .fc-back .fc-label{color:var(--green);}
    .fc-text{font-size:11px;color:var(--text);line-height:1.6;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .fc-hint{font-size:9px;color:var(--text3);margin-top:4px;text-align:right;}
    .fc-generating{background:var(--bg3);border:1px solid var(--border2);border-radius:var(--radius-sm);padding:12px;text-align:center;}
    .fc-gen-spinner{width:18px;height:18px;border:2px solid var(--border2);border-top-color:var(--purple);border-radius:50%;animation:spin 1s linear infinite;margin:0 auto 7px;}
    .fc-gen-text{font-size:11px;color:var(--text2);font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .fc-controls{display:flex;align-items:center;justify-content:space-between;margin-top:7px;}
    .fc-nav-btn{background:var(--bg3);border:1px solid var(--border2);border-radius:var(--radius-xs);padding:3px 9px;font-size:10px;color:var(--text2);cursor:pointer;font-family:'Sora',sans-serif;transition:all .13s;}
    .fc-nav-btn:hover{border-color:var(--purple);color:var(--purple);}
    .fc-nav-btn:disabled{opacity:.4;cursor:not-allowed;}
    .fc-progress-text{font-size:10px;color:var(--text3);}

    /* exam countdown */
    .exam-card{background:linear-gradient(135deg,rgba(77,127,255,.1),rgba(155,111,212,.1));border:1px solid rgba(77,127,255,.2);border-radius:var(--radius-sm);padding:10px 12px;text-align:center;}
    .exam-name{font-size:11px;font-weight:600;color:var(--blue);margin-bottom:3px;}
    .exam-days{font-size:28px;font-weight:700;color:var(--text);line-height:1;}
    .exam-days-label{font-size:10px;color:var(--text2);margin-top:2px;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .rs-upgrade-btn{background:linear-gradient(135deg,var(--amber-bg),rgba(240,160,48,.14));border:1px solid rgba(240,160,48,.25);border-radius:var(--radius-sm);padding:10px 12px;text-align:center;cursor:pointer;transition:all .15s;width:100%;font-family:'Sora',sans-serif;}
    .rs-upgrade-btn:hover{border-color:var(--amber);transform:translateY(-1px);}
    .rs-upgrade-title{font-size:12px;font-weight:700;color:var(--amber);margin-bottom:3px;}
    .rs-upgrade-sub{font-size:10.5px;color:var(--text2);font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .rs-upgrade-pill{display:inline-block;margin-top:7px;background:var(--amber);color:#0d0f14;padding:4px 14px;border-radius:10px;font-size:11px;font-weight:700;}

    /* ═══════════════════════════════════════════════════════
       MODALS
    ═══════════════════════════════════════════════════════ */
    @keyframes fadeOverlay{from{opacity:0}to{opacity:1}}
    @keyframes popCard{from{opacity:0;transform:scale(.93) translateY(14px)}to{opacity:1;transform:scale(1) translateY(0)}}
    #login-overlay{display:none;position:fixed;inset:0;z-index:999;align-items:center;justify-content:center;background:rgba(8,9,12,.78);backdrop-filter:blur(8px);}
    #login-overlay.active{display:flex;animation:fadeOverlay .22s ease both;}
    .login-card{background:var(--bg2);border:1px solid var(--border2);border-radius:16px;padding:24px 24px 20px;max-width:360px;width:calc(100% - 28px);text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.7),0 0 0 1px rgba(77,127,255,.08);animation:popCard .3s cubic-bezier(.34,1.56,.64,1) both;position:relative;}
    .card-close-btn{display:none;position:absolute;top:10px;right:11px;background:var(--bg3);border:1px solid var(--border2);border-radius:5px;width:22px;height:22px;align-items:center;justify-content:center;color:var(--text2);font-size:12px;cursor:pointer;transition:all .13s;}
    .card-close-btn:hover{background:var(--bg4);color:var(--text);}
    .login-card.dismissible .card-close-btn{display:flex;}
    .card-logo{width:48px;height:48px;border-radius:13px;background:var(--bg3);border:1px solid var(--border2);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;padding:7px;}
    .login-card h2{font-size:17px;font-weight:700;color:var(--text);margin-bottom:6px;line-height:1.4;}
    .login-card h2 span{color:var(--blue);}
    .login-card>p{font-size:12px;color:var(--text2);line-height:1.8;margin-bottom:20px;font-family:'Noto Sans Bengali','Sora',sans-serif;}
    .login-card>p strong{color:var(--amber);}
    .login-tabs{display:flex;background:var(--bg3);border:1px solid var(--border2);border-radius:var(--radius-sm);padding:3px;margin-bottom:14px;}
    .login-tab{flex:1;padding:6px;text-align:center;border-radius:var(--radius-xs);cursor:pointer;font-size:12px;color:var(--text2);font-family:'Sora',sans-serif;transition:all .18s;border:none;background:transparent;}
    .login-tab.active{background:var(--bg4);color:var(--text);font-weight:600;}
    .form-field{margin-bottom:9px;text-align:left;}
    .form-field label{display:block;font-size:11px;color:var(--text2);margin-bottom:3px;}
    .form-field input{width:100%;padding:9px 11px;background:var(--input-bg);border:1px solid var(--border2);border-radius:var(--radius-sm);color:var(--text);font-size:13px;font-family:'Sora',sans-serif;outline:none;transition:border-color .18s,box-shadow .18s;}
    .form-field input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(77,127,255,.12);}
    .form-field input::placeholder{color:var(--text3);}
    .card-error{background:rgba(224,90,106,.08);border:1px solid rgba(224,90,106,.2);color:var(--danger);padding:7px 11px;border-radius:var(--radius-xs);font-size:11.5px;margin-bottom:9px;display:none;text-align:left;}
    .card-success{background:rgba(34,197,140,.07);border:1px solid rgba(34,197,140,.18);color:var(--green);padding:7px 11px;border-radius:var(--radius-xs);font-size:11.5px;margin-bottom:9px;display:none;text-align:left;}
    .forgot-link{text-align:right;margin-top:-3px;margin-bottom:9px;}
    .forgot-link button{background:none;border:none;color:var(--blue);font-size:11px;cursor:pointer;font-family:'Sora',sans-serif;}
    .card-btn{width:100%;padding:11px;background:linear-gradient(135deg,var(--blue),var(--purple));color:#fff;border:none;border-radius:var(--radius-sm);font-size:14px;font-weight:700;cursor:pointer;font-family:'Sora',sans-serif;transition:all .15s;margin-top:2px;}
    .card-btn:hover{opacity:.88;transform:translateY(-1px);}
    .card-btn:disabled{background:var(--border);cursor:not-allowed;transform:none;}
    .card-footer{font-size:10.5px;color:var(--text3);margin-top:10px;}
    .card-footer span{color:var(--green);}
    #verify-overlay{display:none;position:fixed;inset:0;z-index:1000;align-items:center;justify-content:center;background:rgba(8,9,12,.85);backdrop-filter:blur(8px);}
    #verify-overlay.active{display:flex;animation:fadeOverlay .22s ease both;}
    .verify-card{background:var(--bg2);border:1px solid var(--border2);border-radius:16px;padding:28px 24px 22px;max-width:360px;width:calc(100% - 28px);text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.7);animation:popCard .3s cubic-bezier(.34,1.56,.64,1) both;}
    .verify-icon{font-size:36px;margin-bottom:12px;}
    .verify-card h2{font-size:16px;font-weight:700;color:var(--text);margin-bottom:6px;}
    .verify-card p{font-size:12px;color:var(--text2);line-height:1.8;margin-bottom:18px;}
    .verify-card p strong{color:var(--blue);}
    .code-inputs{display:flex;gap:6px;justify-content:center;margin-bottom:16px;}
    .code-input{width:40px;height:48px;background:var(--input-bg);border:1px solid var(--border2);border-radius:var(--radius-sm);color:var(--text);font-size:18px;font-weight:700;text-align:center;font-family:monospace;outline:none;transition:border-color .18s,box-shadow .18s;}
    .code-input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(77,127,255,.12);}
    .verify-error{background:rgba(224,90,106,.08);border:1px solid rgba(224,90,106,.2);color:var(--danger);padding:7px 11px;border-radius:var(--radius-xs);font-size:11.5px;margin-bottom:10px;display:none;text-align:left;}
    .verify-success{background:rgba(34,197,140,.07);border:1px solid rgba(34,197,140,.18);color:var(--green);padding:7px 11px;border-radius:var(--radius-xs);font-size:11.5px;margin-bottom:10px;display:none;text-align:left;}
    .verify-btn{width:100%;padding:11px;background:linear-gradient(135deg,var(--blue),var(--purple));color:#fff;border:none;border-radius:var(--radius-sm);font-size:13.5px;font-weight:700;cursor:pointer;font-family:'Sora',sans-serif;transition:all .15s;}
    .verify-btn:hover{opacity:.88;}
    .verify-btn:disabled{background:var(--border);cursor:not-allowed;}
    .resend-link{margin-top:10px;font-size:11px;color:var(--text3);}
    .resend-link button{background:none;border:none;color:var(--blue);cursor:pointer;font-size:11px;font-family:'Sora',sans-serif;}
    .resend-link button:disabled{color:var(--text3);cursor:not-allowed;}
    #forgot-overlay{display:none;position:fixed;inset:0;z-index:1001;align-items:center;justify-content:center;background:rgba(8,9,12,.85);backdrop-filter:blur(8px);}
    #forgot-overlay.active{display:flex;animation:fadeOverlay .22s ease both;}
    .forgot-card{background:var(--bg2);border:1px solid var(--border2);border-radius:16px;padding:26px 24px 20px;max-width:380px;width:calc(100% - 28px);text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.7);animation:popCard .3s cubic-bezier(.34,1.56,.64,1) both;max-height:90vh;overflow-y:auto;}
    .forgot-logo{width:44px;height:44px;border-radius:12px;background:var(--bg3);border:1px solid var(--border2);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;padding:6px;}
    .forgot-card h2{font-size:16px;font-weight:700;color:var(--text);margin-bottom:6px;}
    .forgot-card p.forgot-sub{font-size:12px;color:var(--text2);line-height:1.75;margin-bottom:16px;}
    .forgot-field{margin-bottom:9px;text-align:left;}
    .forgot-field label{display:block;font-size:11px;color:var(--text2);margin-bottom:3px;}
    .forgot-field input{width:100%;padding:9px 11px;background:var(--input-bg);border:1px solid var(--border2);border-radius:var(--radius-sm);color:var(--text);font-size:13px;font-family:'Sora',sans-serif;outline:none;transition:border-color .18s;}
    .forgot-field input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(77,127,255,.12);}
    .forgot-error{background:rgba(224,90,106,.08);border:1px solid rgba(224,90,106,.2);color:var(--danger);padding:7px 11px;border-radius:var(--radius-xs);font-size:11.5px;margin-bottom:9px;display:none;text-align:left;}
    .forgot-success{background:rgba(34,197,140,.07);border:1px solid rgba(34,197,140,.18);color:var(--green);padding:7px 11px;border-radius:var(--radius-xs);font-size:11.5px;margin-bottom:9px;display:none;text-align:left;}
    .forgot-btn{width:100%;padding:11px;background:linear-gradient(135deg,var(--blue),var(--purple));color:#fff;border:none;border-radius:var(--radius-sm);font-size:13.5px;font-weight:700;cursor:pointer;font-family:'Sora',sans-serif;transition:all .15s;margin-top:2px;}
    .forgot-btn:hover{opacity:.88;}
    .forgot-btn:disabled{background:var(--border);cursor:not-allowed;}
    .reset-code-inputs{display:flex;gap:6px;justify-content:center;margin-bottom:12px;}
    .reset-code-input{width:38px;height:46px;background:var(--input-bg);border:1px solid var(--border2);border-radius:var(--radius-sm);color:var(--text);font-size:17px;font-weight:700;text-align:center;font-family:monospace;outline:none;transition:border-color .18s;}
    .reset-code-input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(77,127,255,.12);}
    .password-strength{margin-top:3px;height:3px;border-radius:3px;background:var(--border2);overflow:hidden;}
    .password-strength-bar{height:100%;border-radius:3px;transition:width .3s,background .3s;width:0;}
    .back-link{text-align:center;margin-top:9px;}
    .back-link button{background:none;border:none;color:var(--text2);font-size:11px;cursor:pointer;font-family:'Sora',sans-serif;}

    /* ═══════════════════════════════════════════════════════
       MOBILE BOTTOM NAV
    ═══════════════════════════════════════════════════════ */
    .mobile-bottom-nav{
      display:none; height:56px; background:var(--bg2);
      border-top:1px solid var(--border);
      flex-shrink:0; align-items:stretch;
      padding-bottom:var(--safe-bottom);
    }
    .mob-nav-btn{
      flex:1; display:flex; flex-direction:column; align-items:center;
      justify-content:center; gap:3px; background:transparent; border:none;
      color:var(--text3); cursor:pointer; font-family:'Sora',sans-serif;
      transition:color .15s; padding:4px 0;
    }
    .mob-nav-btn.active{color:var(--green);}
    .mob-nav-btn:hover{color:var(--text2);}
    .mob-nav-icon{font-size:19px; line-height:1;}
    .mob-nav-label{font-size:9px; font-weight:600; letter-spacing:.02em;}

    /* ═══════════════════════════════════════════════════════
       RESPONSIVE
    ═══════════════════════════════════════════════════════ */
    @media(max-width:1100px){:root{--right-w:210px;}}
    @media(max-width:900px){.right-sidebar{display:none;}}
    @media(max-width:700px){
      header{display:none;}
      .left-sidebar{display:none;}
      .right-sidebar{display:none;}
      .mobile-bottom-nav{display:flex;}
      .app-layout{flex-direction:column;}
      .main-content{border-right:none;}
      #home-view{padding:16px 16px 12px;gap:14px;}
      .home-greeting-card{padding:16px 16px; gap:14px; align-items:flex-start;}
      .greeting-avatar{width:60px; height:60px; font-size:28px;}
      .greeting-title{font-size:14px; margin-bottom:6px;}
      .greeting-cta{margin-top:10px; font-size:12px; padding:9px 16px;}
      .greeting-ssc-badge{display:none;}
      .home-stats-row{grid-template-columns:repeat(3,1fr);gap:7px;}
      .stat-card{padding:16px 12px;}
      .stat-value{font-size:24px;}
      .stat-label{font-size:10px; margin-top:4px;}
      .home-focus-card{padding:14px 16px;}
      .focus-title{font-size:18px; margin-bottom:5px;}
      .focus-sub{font-size:11px; margin-bottom:10px;}
      .focus-pct{font-size:11px;}
      .focus-cta{margin-top:12px; font-size:12px; padding:8px 14px;}
      .recent-chat-item{padding:10px 12px; gap:10px;}
      .rc-title{font-size:12px;}
      .rc-dot{width:8px; height:8px;}
      #chat-box{padding:14px 12px 8px;gap:13px;}
      #input-area{padding:8px 10px calc(10px + var(--safe-bottom));}
      .user .bubble{max-width:84%;}
      .bot .bubble{font-size:13px;padding:11px 13px;}
      .message-actions{opacity:1;}
      .subject-grid{grid-template-columns:repeat(2,1fr);}
    }
  </style>
</head>
<body>

<svg style="display:none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="sheelbi-blue-purple" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#4d7fff"/>
      <stop offset="100%" stop-color="#9b6fd4"/>
    </linearGradient>
  </defs>
</svg>

<!-- ═══ HEADER (desktop only) ═══ -->
<header>
  <div class="header-left">
    <button class="hamburger-btn" id="hamburger-btn" onclick="toggleSidebar()" title="Menu">☰</button>
    <div class="logo-mark">
      <svg width="24" height="24" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <line x1="50" y1="52" x2="50" y2="6" stroke="#4d7fff" stroke-width="15" stroke-linecap="round"/>
        <line x1="50" y1="52" x2="92" y2="30" stroke="url(#sheelbi-blue-purple)" stroke-width="15" stroke-linecap="round"/>
        <line x1="50" y1="52" x2="80" y2="90" stroke="#9b6fd4" stroke-width="15" stroke-linecap="round"/>
        <line x1="50" y1="52" x2="6" y2="44" stroke="#f0a030" stroke-width="15" stroke-linecap="round"/>
        <line x1="50" y1="52" x2="22" y2="88" stroke="#c87820" stroke-width="15" stroke-linecap="round"/>
        <line x1="50" y1="52" x2="50" y2="94" stroke="#22c58c" stroke-width="15" stroke-linecap="round"/>
        <circle cx="50" cy="52" r="10" fill="#0d0f14"/>
        <circle cx="50" cy="52" r="6.5" fill="#f0a030"/>
      </svg>
    </div>
    <div class="logo-text">
      <h1>Sheelbi</h1>
      <p>NCTB · ক্লাস ১–১২</p>
    </div>
  </div>
  <div class="header-center">
    <div class="deepti-pill">
      <div class="deepti-avatar">D</div>
      <div><div class="deepti-name">Deepti Online</div></div>
      <div class="deepti-dot" id="status-dot"></div>
    </div>
  </div>
  <div class="header-right">
    <button class="hdr-icon-btn" id="theme-btn" onclick="toggleTheme()" title="Toggle theme">☀️</button>
    <button class="hdr-btn-login" id="header-login-btn" onclick="showLoginPrompt(false)">Login</button>
    <button class="hdr-btn-new" onclick="newChat()">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
      New Chat
    </button>
  </div>
</header>

<div class="app-layout">
  <div class="sidebar-overlay" id="sidebar-overlay" onclick="closeSidebar()"></div>

  <!-- ═══ LEFT SIDEBAR ═══ -->
  <div class="left-sidebar" id="sidebar">
    <!-- Profile -->
    <div class="sb-profile">
      <div style="display:flex;justify-content:space-between;align-items:center;width:100%;">
        <div class="sb-profile-row" style="flex:1;">
          <div class="sb-user-avatar" id="sb-user-avatar">IH</div>
          <div class="sb-user-info">
            <div class="sb-user-name" id="sb-user-name">Ibo Hanma</div>
            <div class="sb-user-meta">
              <span class="sb-class-badge">Class 9 · SSC 2026</span>
              <span class="sb-plan-badge" id="sb-plan-badge">Free</span>
            </div>
          </div>
        </div>
        <button class="sb-minimize-btn" id="sidebar-minimize-btn" onclick="toggleSidebarMinimize()" title="Collapse sidebar">◄</button>
      </div>
      <div class="streak-compact">
        <span>⏱️</span>
        <span class="streak-compact-num" id="time-spent-display">0h 0m</span>
        <span class="streak-compact-label">· Time spent today</span>
      </div>
      <button class="sb-new-chat-btn" onclick="newChat()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
        New Chat
      </button>
    </div>

    <!-- Nav -->
    <div class="sb-nav">
      <button class="sb-nav-item active" id="nav-home" onclick="showHome()">
        <span class="sb-nav-icon">🏠</span> Home
      </button>
      <button class="sb-nav-item" id="nav-chats" onclick="openChat()">
        <span class="sb-nav-icon">💬</span> All chats
        <span style="margin-left:auto;font-size:9px;background:var(--bg5);color:var(--text3);padding:1px 6px;border-radius:8px;">12</span>
      </button>
    </div>

    <!-- Folders -->
    <div class="sb-folders-section">
      <div class="sb-folders-header">
        <span class="sb-folders-label">MY FOLDERS</span>
        <button class="sb-folder-add-btn" onclick="showFolderInput()" title="New folder">+</button>
      </div>
      <div class="sb-folders-list" id="folders-list"></div>
      <div class="folder-input-row" id="folder-input-row">
        <input type="text" class="folder-input" id="folder-name-input" placeholder="Folder name..." maxlength="24" onkeydown="folderInputKey(event)">
        <button class="folder-input-confirm" onclick="confirmNewFolder()">Add</button>
      </div>
    </div>

    <!-- Battle mode teaser -->
    <div style="margin:8px 10px;background:rgba(155,111,212,.08);border:1px solid rgba(155,111,212,.2);border-radius:var(--radius-sm);padding:8px 10px;cursor:pointer;display:flex;align-items:center;gap:8px;" onclick="showLoginPrompt(false)">
      <span style="font-size:13px;">⚔️</span>
      <div>
        <div style="font-size:11px;font-weight:700;color:var(--purple);">Battle Mode</div>
        <div style="font-size:9.5px;color:var(--text2);">3 friends online</div>
      </div>
    </div>

    <!-- Upgrade -->
    <div class="sb-upgrade-btn" onclick="showLoginPrompt(false)">
      <span class="sb-upgrade-icon">⭐</span>
      <div class="sb-upgrade-text">
        <div class="sb-upgrade-title">Upgrade to Pro</div>
        <div class="sb-upgrade-sub">Unlimited প্রশ্ন + ফিচার</div>
      </div>
    </div>

    <!-- Footer profile -->
    <div class="sb-footer">
      <div class="sidebar-profile-menu" id="sidebar-profile-menu">
        <div class="spm-header">
          <div class="spm-avatar"><span id="spm-initials">IH</span></div>
          <div class="spm-info">
            <div class="spm-name" id="spm-name">Ibo Hanma</div>
            <div class="spm-email" id="spm-email">—</div>
            <div class="spm-plan-badge" id="spm-plan-badge-menu">Free</div>
          </div>
        </div>
        <div class="spm-body">
          <button class="spm-item" onclick="openChat()"><span class="spm-item-icon">✏️</span> New Chat</button>
          <div class="spm-divider"></div>
          <button class="spm-item danger" onclick="handleLogout()"><span class="spm-item-icon">↩</span> Log out</button>
        </div>
      </div>
      <button class="sb-profile-btn" id="sidebar-profile-btn" onclick="toggleSidebarMenu()">
        <div class="sb-avatar"><span id="sidebar-initials">IH</span></div>
        <div class="sb-profile-info">
          <div class="sb-profile-name" id="sidebar-profile-name">Ibo Hanma</div>
          <div class="sb-profile-email" id="sidebar-profile-email">—</div>
        </div>
        <span class="sb-chevron">▲</span>
      </button>
    </div>
  </div>

  <!-- ═══ MAIN CONTENT ═══ -->
  <div class="main-content" id="main-content">

    <!-- ── HOME VIEW ── -->
    <div id="home-view">

      <!-- Greeting card -->
      <div class="home-greeting-card">
        <div class="greeting-avatar">🤖</div>
        <div class="greeting-body">
          <div class="greeting-title" id="greeting-title">আসসালামু আলাইকুম Ibo! গতকাল Trigonometry-তে তুমি 62% পেরেছিলে। আজ মাত্র ১৫ মিনিট এটা ঠিক করে নিই — রেডি?</div>
          <div class="greeting-sub">দীপ্তি — তোমার AI গৃহশিক্ষক</div>
          <button class="greeting-cta" onclick="openChat()">
            হ্যাঁ, চলো শুরু করি →
          </button>
        </div>
        <div class="greeting-ssc-badge">SSC 2026 · <span id="ssc-days">—</span> days left</div>
      </div>

      <!-- Stats row -->
      <div class="home-stats-row">
        <div class="stat-card">
          <div class="stat-value" style="color:var(--amber);">7</div>
          <div class="stat-label">day streak 🔥</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" style="color:var(--blue);" id="stat-q-today">0</div>
          <div class="stat-label">questions today</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" style="color:var(--green);">74%</div>
          <div class="stat-label">avg score</div>
        </div>
      </div>

      <!-- Focus area -->
      <div class="home-focus-card">
        <div class="focus-label-row">
          <span class="focus-badge">★ Focus area</span>
          <span class="focus-badge-label">needs attention</span>
        </div>
        <div class="focus-title">Trigonometry</div>
        <div class="focus-sub">দীপ্তি এটা targeted practice রেডি করেছে তোমার জন্য</div>
        <div class="focus-bar-wrap">
          <div class="focus-bar-bg"><div class="focus-bar" style="width:42%;"></div></div>
          <span class="focus-pct">42%</span>
        </div>
        <button class="focus-cta" onclick="openChat('ত্রিকোণমিতি practice করতে চাই — আজকের targeted session শুরু করো')">
          Practice now →
        </button>
      </div>

      <!-- Recent chats -->
      <div>
        <div class="home-section-title">RECENT CHATS</div>
        <div class="recent-chat-list" id="recent-chat-list">
          <div class="recent-chat-item" onclick="openChat()">
            <div class="rc-dot blue"></div>
            <div class="rc-info">
              <div class="rc-title">সালোকসংশ্লেষের প্রক্রিয়া ব্যাখ্যা</div>
              <div class="rc-folder">SSC Prep 2026</div>
            </div>
            <div class="rc-time">1m ago</div>
            <div class="rc-arrow">›</div>
          </div>
          <div class="recent-chat-item" onclick="openChat()">
            <div class="rc-dot blue"></div>
            <div class="rc-info">
              <div class="rc-title">Osmosis and cell transport</div>
              <div class="rc-folder">SSC Prep 2026</div>
            </div>
            <div class="rc-time">2h ago</div>
            <div class="rc-arrow">›</div>
          </div>
          <div class="recent-chat-item" onclick="openChat()">
            <div class="rc-dot amber"></div>
            <div class="rc-info">
              <div class="rc-title">এসিড ও ক্ষার — পার্থক্য কী?</div>
              <div class="rc-folder">Chemistry Notes</div>
            </div>
            <div class="rc-time">Yesterday</div>
            <div class="rc-arrow">›</div>
          </div>
          <div class="recent-chat-item" onclick="openChat()">
            <div class="rc-dot green"></div>
            <div class="rc-info">
              <div class="rc-title">English tense — homework help</div>
              <div class="rc-folder">English Practice</div>
            </div>
            <div class="rc-time">2 days ago</div>
            <div class="rc-arrow">›</div>
          </div>
        </div>
      </div>

    </div><!-- end #home-view -->

    <!-- ── CHAT VIEW ── -->
    <div id="chat-view">

      <!-- LOGIN OVERLAY -->
      <div id="login-overlay">
        <div id="login-backdrop" style="position:absolute;inset:0;" onclick="tryDismissLogin()"></div>
        <div class="login-card" id="login-card">
          <button class="card-close-btn" onclick="hideLoginPrompt()">✕</button>
          <div class="card-logo">
            <svg width="34" height="34" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
              <line x1="50" y1="52" x2="50" y2="6" stroke="#4d7fff" stroke-width="15" stroke-linecap="round"/>
              <line x1="50" y1="52" x2="92" y2="30" stroke="url(#sheelbi-blue-purple)" stroke-width="15" stroke-linecap="round"/>
              <line x1="50" y1="52" x2="80" y2="90" stroke="#9b6fd4" stroke-width="15" stroke-linecap="round"/>
              <line x1="50" y1="52" x2="6" y2="44" stroke="#f0a030" stroke-width="15" stroke-linecap="round"/>
              <line x1="50" y1="52" x2="22" y2="88" stroke="#c87820" stroke-width="15" stroke-linecap="round"/>
              <line x1="50" y1="52" x2="50" y2="94" stroke="#22c58c" stroke-width="15" stroke-linecap="round"/>
              <circle cx="50" cy="52" r="10" fill="#0d0f14"/>
              <circle cx="50" cy="52" r="6.5" fill="#f0a030"/>
            </svg>
          </div>
          <h2 id="login-modal-title">Welcome to <span>Sheelbi!</span></h2>
          <p id="login-modal-sub">Login or create a free account to start chatting.<br><strong>10 questions/day</strong> at no cost.</p>
          <div class="login-form">
            <div class="login-tabs">
              <button class="login-tab active" onclick="switchCardTab('login')">Login</button>
              <button class="login-tab" onclick="switchCardTab('register')">Register</button>
            </div>
            <div id="card-error" class="card-error"></div>
            <div id="card-success" class="card-success"></div>
            <div class="form-field" id="card-name-field" style="display:none;">
              <label>Your Name</label>
              <input type="text" id="card-name" placeholder="e.g. Tasnim Zara" />
            </div>
            <div class="form-field">
              <label>Email</label>
              <input type="email" id="card-email" placeholder="example@gmail.com" />
            </div>
            <div class="form-field" id="card-password-field">
              <label>Password</label>
              <input type="password" id="card-password" placeholder="At least 6 characters" />
            </div>
            <div class="forgot-link" id="forgot-password-link">
              <button onclick="showForgotPassword()">Forgot password?</button>
            </div>
            <button class="card-btn" id="card-submit" onclick="handleCardSubmit()">Login</button>
            <div class="card-footer">Start free — <span>10 questions/day</span> at no cost</div>
          </div>
        </div>
      </div>

      <!-- VERIFY EMAIL -->
      <div id="verify-overlay">
        <div class="verify-card">
          <div class="verify-icon">📧</div>
          <h2>Check your email!</h2>
          <p>We sent a 6-digit code to<br><strong id="verify-email-display">your email</strong><br>Enter it below to verify your account.</p>
          <div id="verify-error" class="verify-error"></div>
          <div id="verify-success" class="verify-success"></div>
          <div class="code-inputs">
            <input class="code-input" maxlength="1" id="c1" oninput="codeInput(this,null,'c2')" onkeydown="codeKey(event,this,null,'c2')">
            <input class="code-input" maxlength="1" id="c2" oninput="codeInput(this,'c1','c3')" onkeydown="codeKey(event,this,'c1','c3')">
            <input class="code-input" maxlength="1" id="c3" oninput="codeInput(this,'c2','c4')" onkeydown="codeKey(event,this,'c2','c4')">
            <input class="code-input" maxlength="1" id="c4" oninput="codeInput(this,'c3','c5')" onkeydown="codeKey(event,this,'c3','c5')">
            <input class="code-input" maxlength="1" id="c5" oninput="codeInput(this,'c4','c6')" onkeydown="codeKey(event,this,'c4','c6')">
            <input class="code-input" maxlength="1" id="c6" oninput="codeInput(this,'c5',null)" onkeydown="codeKey(event,this,'c5',null)">
          </div>
          <button class="verify-btn" id="verify-btn" onclick="submitVerifyCode()">Verify Email ✓</button>
          <div class="resend-link">Didn't get it? <button id="resend-btn" onclick="resendCode()">Resend code</button></div>
        </div>
      </div>

      <!-- FORGOT PASSWORD -->
      <div id="forgot-overlay">
        <div class="forgot-card" id="forgot-card">
          <div id="forgot-step-1">
            <div class="forgot-logo"><svg width="32" height="32" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><line x1="50" y1="52" x2="50" y2="6" stroke="#4d7fff" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="92" y2="30" stroke="url(#sheelbi-blue-purple)" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="80" y2="90" stroke="#9b6fd4" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="6" y2="44" stroke="#f0a030" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="22" y2="88" stroke="#c87820" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="50" y2="94" stroke="#22c58c" stroke-width="15" stroke-linecap="round"/><circle cx="50" cy="52" r="10" fill="#0d0f14"/><circle cx="50" cy="52" r="6.5" fill="#f0a030"/></svg></div>
            <h2>Forgot Password?</h2>
            <p class="forgot-sub">Enter your email and we'll send you a reset code.</p>
            <div id="forgot-error" class="forgot-error"></div>
            <div id="forgot-success" class="forgot-success"></div>
            <div class="forgot-field"><label>Email</label><input type="email" id="forgot-email" placeholder="example@gmail.com" /></div>
            <button class="forgot-btn" id="forgot-send-btn" onclick="sendResetCode()">Send Reset Code</button>
            <div class="back-link"><button onclick="hideForgotPassword()">← Back to Login</button></div>
          </div>
          <div id="forgot-step-2" style="display:none;">
            <div class="forgot-logo"><svg width="32" height="32" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><line x1="50" y1="52" x2="50" y2="6" stroke="#4d7fff" stroke-width="15" stroke-linecap="round"/><circle cx="50" cy="52" r="10" fill="#0d0f14"/><circle cx="50" cy="52" r="6.5" fill="#f0a030"/></svg></div>
            <h2>Enter reset code</h2>
            <p class="forgot-sub">Check your email at<br><strong id="forgot-email-display">—</strong></p>
            <div id="reset-error" class="forgot-error"></div>
            <div id="reset-success" class="forgot-success"></div>
            <div class="reset-code-inputs">
              <input class="reset-code-input" maxlength="1" id="r1" oninput="resetCodeInput(this,null,'r2')" onkeydown="resetCodeKey(event,this,null,'r2')">
              <input class="reset-code-input" maxlength="1" id="r2" oninput="resetCodeInput(this,'r1','r3')" onkeydown="resetCodeKey(event,this,'r1','r3')">
              <input class="reset-code-input" maxlength="1" id="r3" oninput="resetCodeInput(this,'r2','r4')" onkeydown="resetCodeKey(event,this,'r2','r4')">
              <input class="reset-code-input" maxlength="1" id="r4" oninput="resetCodeInput(this,'r3','r5')" onkeydown="resetCodeKey(event,this,'r3','r5')">
              <input class="reset-code-input" maxlength="1" id="r5" oninput="resetCodeInput(this,'r4','r6')" onkeydown="resetCodeKey(event,this,'r4','r6')">
              <input class="reset-code-input" maxlength="1" id="r6" oninput="resetCodeInput(this,'r5',null)" onkeydown="resetCodeKey(event,this,'r5',null)">
            </div>
            <div class="forgot-field"><label>New Password</label><input type="password" id="new-password" placeholder="At least 6 characters" oninput="checkPasswordStrength(this.value)"/><div class="password-strength"><div class="password-strength-bar" id="strength-bar"></div></div></div>
            <div class="forgot-field"><label>Confirm New Password</label><input type="password" id="confirm-password" placeholder="Re-enter new password" oninput="checkConfirmMatch()"/><div class="password-strength"><div class="password-strength-bar" id="confirm-strength-bar"></div></div></div>
            <button class="forgot-btn" id="reset-btn" onclick="submitResetPassword()">Reset Password</button>
            <div class="back-link"><button onclick="showForgotStep1()">← Back</button></div>
          </div>
        </div>
      </div>

      <!-- Chat box -->
      <div id="chat-box">
        <div class="welcome" id="welcome-screen">
          <div class="welcome-glow">
            <div class="welcome-icon">
              <svg width="48" height="48" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <line x1="50" y1="52" x2="50" y2="6" stroke="#4d7fff" stroke-width="15" stroke-linecap="round"/>
                <line x1="50" y1="52" x2="92" y2="30" stroke="url(#sheelbi-blue-purple)" stroke-width="15" stroke-linecap="round"/>
                <line x1="50" y1="52" x2="80" y2="90" stroke="#9b6fd4" stroke-width="15" stroke-linecap="round"/>
                <line x1="50" y1="52" x2="6" y2="44" stroke="#f0a030" stroke-width="15" stroke-linecap="round"/>
                <line x1="50" y1="52" x2="22" y2="88" stroke="#c87820" stroke-width="15" stroke-linecap="round"/>
                <line x1="50" y1="52" x2="50" y2="94" stroke="#22c58c" stroke-width="15" stroke-linecap="round"/>
                <circle cx="50" cy="52" r="10" fill="#0d0f14"/>
                <circle cx="50" cy="52" r="6.5" fill="#f0a030"/>
              </svg>
            </div>
          </div>
          <h2>আসসালামু আলাইকুম! 👋</h2>
          <p class="welcome-sub">আমি তোমার <strong style="color:var(--blue)">দীপ্তি আপু</strong> — তোমার AI টিউটর।<br>বাংলা বা English যেকোনো ভাষায় প্রশ্ন করো!</p>
          <p class="welcome-img-note">📎 ছবি আপলোড করেও প্রশ্ন করা যাবে!</p>
          <div class="subject-grid">
            <div class="subj-card" onclick="sendSuggestion(this)" data-q="দ্বিঘাত সমীকরণ কী? সহজ করে বোঝাও"><div class="subj-card-icon">🔢</div><div class="subj-card-title">গণিত</div><div class="subj-card-example">দ্বিঘাত সমীকরণ কী?</div></div>
            <div class="subj-card" onclick="sendSuggestion(this)" data-q="সালোকসংশ্লেষণ প্রক্রিয়া ব্যাখ্যা করো"><div class="subj-card-icon">🌿</div><div class="subj-card-title">বিজ্ঞান</div><div class="subj-card-example">Explain photosynthesis</div></div>
            <div class="subj-card" onclick="sendSuggestion(this)" data-q="পিথাগোরাসের উপপাদ্য কী? প্রমাণ দাও"><div class="subj-card-icon">📐</div><div class="subj-card-title">জ্যামিতি</div><div class="subj-card-example">পিথাগোরাসের উপপাদ্য</div></div>
            <div class="subj-card" onclick="sendSuggestion(this)" data-q="What is osmosis? Explain with example"><div class="subj-card-icon">🔬</div><div class="subj-card-title">Biology</div><div class="subj-card-example">What is osmosis?</div></div>
            <div class="subj-card" onclick="sendSuggestion(this)" data-q="এসিড ও ক্ষারের পার্থক্য কী?"><div class="subj-card-icon">⚗️</div><div class="subj-card-title">রসায়ন</div><div class="subj-card-example">এসিড ও ক্ষার</div></div>
            <div class="subj-card" onclick="sendSuggestion(this)" data-q="নিউটনের গতিসূত্র তিনটি ব্যাখ্যা করো"><div class="subj-card-icon">💡</div><div class="subj-card-title">পদার্থবিজ্ঞান</div><div class="subj-card-example">নিউটনের সূত্র</div></div>
          </div>
        </div>
      </div><!-- end #chat-box -->

      <button id="scroll-btn" onclick="scrollToBottom()">↓ নিচে যাও</button>

      <div id="input-area">
        <div id="quick-panel">
          <button class="quick-pill" onclick="useQuick(this)">দ্বিঘাত সমীকরণ সমাধান করো</button>
          <button class="quick-pill" onclick="useQuick(this)">সহজ করে বোঝাও</button>
          <button class="quick-pill" onclick="useQuick(this)">আরেকটি উদাহরণ দাও</button>
          <button class="quick-pill" onclick="useQuick(this)">অনুশীলনী প্রশ্ন দাও</button>
          <button class="quick-pill" onclick="useQuick(this)">ধাপে ধাপে দেখাও</button>
          <button class="quick-pill" onclick="useQuick(this)">Explain in English</button>
          <button class="quick-pill" onclick="useQuick(this)">সূত্র মনে করিয়ে দাও</button>
          <button class="quick-pill" onclick="useQuick(this)">পরীক্ষার প্রশ্ন দাও</button>
        </div>
        <div id="image-preview-strip">
          <img id="preview-thumb" src="" alt="preview">
          <span id="preview-name"></span>
          <button id="remove-image-btn" onclick="removeImage()">✕</button>
        </div>
        <div id="input-row">
          <input type="file" id="file-input" accept="image/*" onchange="handleFileSelect(event)">
          <button class="inp-icon-btn" id="attach-btn" title="ছবি যোগ করো" onclick="document.getElementById('file-input').click()">📎</button>
          <button class="inp-icon-btn" id="quick-btn" title="সাজেশন (Ctrl+/)" onclick="toggleQuickPanel()">💡</button>
          <textarea id="user-input" placeholder="বাংলা বা English এ প্রশ্ন লেখো..." rows="1"
            onkeydown="handleKey(event)" oninput="autoResize(this);updateCharCount(this)"></textarea>
          <button id="send-btn" onclick="sendMessage()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
          </button>
        </div>
        <div class="hint-bar">
          <span class="hint">Enter পাঠাও &nbsp;·&nbsp; Shift+Enter নতুন লাইন &nbsp;·&nbsp; 💡 সাজেশন</span>
          <span class="char-count" id="char-count"></span>
        </div>
      </div>
    </div><!-- end #chat-view -->

  </div><!-- end .main-content -->

  <!-- ═══ RIGHT SIDEBAR ═══ -->
  <div class="right-sidebar" id="right-sidebar">
    <div class="rs-section">
      <div class="rs-title">📊 Today's Progress</div>
      <div class="progress-card">
        <div>
          <div class="progress-num" id="rs-question-count">0</div>
          <div class="progress-label">প্রশ্ন আজকে</div>
          <div class="progress-sub" id="rs-remaining">10 remaining today</div>
        </div>
        <div class="streak-badge">
          <div class="streak-badge-num">🔥 7</div>
          <div class="streak-badge-label">day streak</div>
        </div>
      </div>
    </div>
    <div class="rs-section">
      <div class="rs-title">⚠️ Weak Areas</div>
      <div class="weak-area-list">
        <div class="weak-item"><span class="weak-icon">📐</span><div class="weak-info"><div class="weak-name">ত্রিকোণমিতি</div><div class="weak-score low">42% correct</div><div class="weak-bar-bg"><div class="weak-bar" style="width:42%;background:var(--danger)"></div></div></div></div>
        <div class="weak-item"><span class="weak-icon">⚗️</span><div class="weak-info"><div class="weak-name">রাসায়নিক বিক্রিয়া</div><div class="weak-score mid">58% correct</div><div class="weak-bar-bg"><div class="weak-bar" style="width:58%;background:var(--amber)"></div></div></div></div>
        <div class="weak-item"><span class="weak-icon">⚡</span><div class="weak-info"><div class="weak-name">বিদ্যুৎ</div><div class="weak-score mid">74% correct</div><div class="weak-bar-bg"><div class="weak-bar" style="width:74%;background:var(--amber)"></div></div></div></div>
      </div>
    </div>
    <div class="rs-section">
      <div class="rs-title" style="display:flex;align-items:center;justify-content:space-between;">
        <span>🃏 Flashcards</span>
        <span id="fc-topic-label" style="font-size:9px;color:var(--purple);font-weight:600;max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"></span>
      </div>
      <div id="flashcard-container">
        <div class="flashcard-empty"><div class="flashcard-empty-icon">🃏</div>Chat with Deepti to<br>auto-generate flashcards!</div>
      </div>
    </div>
    <div class="rs-section">
      <div class="rs-title">🎯 SSC Exam</div>
      <div class="exam-card">
        <div class="exam-name">SSC Exam 2026</div>
        <div class="exam-days" id="exam-days">—</div>
        <div class="exam-days-label">days remaining</div>
      </div>
    </div>
    <div class="rs-section">
      <button class="rs-upgrade-btn" onclick="showLoginPrompt(false)">
        <div class="rs-upgrade-title">⭐ Pro Plan</div>
        <div class="rs-upgrade-sub">Unlimited প্রশ্ন + সব ফিচার</div>
        <div class="rs-upgrade-pill">Upgrade Now</div>
      </button>
    </div>
  </div>

</div><!-- end .app-layout -->

<!-- MOBILE BOTTOM NAV -->
<nav class="mobile-bottom-nav" id="mobile-bottom-nav">
  <button class="mob-nav-btn active" id="mob-home" onclick="showHome(); setMobNav('mob-home')">
    <span class="mob-nav-icon">🏠</span>
    <span class="mob-nav-label">Home</span>
  </button>
  <button class="mob-nav-btn" id="mob-chats" onclick="openChat(); setMobNav('mob-chats')">
    <span class="mob-nav-icon">💬</span>
    <span class="mob-nav-label">Chats</span>
  </button>
  <button class="mob-nav-btn" id="mob-subjects" onclick="openChat(); setMobNav('mob-subjects')">
    <span class="mob-nav-icon">📚</span>
    <span class="mob-nav-label">Subjects</span>
  </button>
  <button class="mob-nav-btn" id="mob-battle" onclick="showLoginPrompt(false)">
    <span class="mob-nav-icon">⚔️</span>
    <span class="mob-nav-label">Battle</span>
  </button>
  <button class="mob-nav-btn" id="mob-profile" onclick="showLoginPrompt(false)">
    <span class="mob-nav-icon">👤</span>
    <span class="mob-nav-label">Profile</span>
  </button>
</nav>

<script>
// ═══════════════════════════════════════════════
// VARS
// ═══════════════════════════════════════════════
const chatBox       = document.getElementById('chat-box');
const input         = document.getElementById('user-input');
const sendBtn       = document.getElementById('send-btn');
const attachBtn     = document.getElementById('attach-btn');
const strip         = document.getElementById('image-preview-strip');
const scrollBtn     = document.getElementById('scroll-btn');
const quickPanel    = document.getElementById('quick-panel');
const quickBtn      = document.getElementById('quick-btn');
const loginOverlay  = document.getElementById('login-overlay');
const verifyOverlay = document.getElementById('verify-overlay');
const forgotOverlay = document.getElementById('forgot-overlay');
const sidebar       = document.getElementById('sidebar');
const sidebarOverlay= document.getElementById('sidebar-overlay');
const homeView      = document.getElementById('home-view');
const chatView      = document.getElementById('chat-view');

const highlightExt={name:'highlight',level:'inline',start(src){return src.indexOf('==');},tokenizer(src){const m=src.match(/^==([^=]+)==/);if(m)return{type:'highlight',raw:m[0],text:m[1]};},renderer(token){return`<mark>${token.text}</mark>`;}};
marked.use({extensions:[highlightExt],breaks:true,gfm:true});

let selectedFile=null,isDark=true,cardTab='login',verifyEmail='',resetEmail='',currentChatId=null,sidebarOpen=false,sidebarMenuOpen=false,verifySubmitting=false,resetSubmitting=false,statusResetTimer=null,allChats=[],flashcardData=[],flashcardIdx=0,fcGenerating=false;
let currentView='home'; // 'home' | 'chat'

const GUEST_LIMIT=5;
function getGuestCount(){return parseInt(sessionStorage.getItem('guest_msg_count')||'0');}
function incrementGuestCount(){sessionStorage.setItem('guest_msg_count',getGuestCount()+1);}
function isGuestLimitReached(){return getGuestCount()>=GUEST_LIMIT;}

// ═══════════════════════════════════════════════
// TIME TRACKING
// ═══════════════════════════════════════════════
let timeStarted=Date.now();
let totalMinutes=0;
function updateTimeDisplay(){
  const now=Date.now();
  const elapsed=Math.floor((now-timeStarted)/60000);
  totalMinutes=elapsed;
  const hours=Math.floor(elapsed/60);
  const mins=elapsed%60;
  const display=document.getElementById('time-spent-display');
  if(display){
    display.textContent=`${hours}h ${mins}m`;
  }
}
setInterval(updateTimeDisplay,60000);
updateTimeDisplay();

// ═══════════════════════════════════════════════
// VIEW SWITCHING
// ═══════════════════════════════════════════════
function showHome(){
  currentView='home';
  homeView.style.display='flex';
  chatView.classList.remove('active');
  document.getElementById('nav-home')?.classList.add('active');
  document.getElementById('nav-chats')?.classList.remove('active');
}

function newChat(){
  currentChatId=null;
  currentView='chat';
  homeView.style.display='none';
  chatView.classList.add('active');
  document.getElementById('nav-home')?.classList.remove('active');
  document.getElementById('nav-chats')?.classList.add('active');
  closeSidebar();
  // Clear chat box
  chatBox.innerHTML='';
  const welcome=document.createElement('div');
  welcome.id='welcome-screen';
  welcome.className='welcome';
  welcome.innerHTML=`<div class="welcome-glow"><div class="welcome-icon"><svg width="48" height="48" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><line x1="50" y1="52" x2="50" y2="6" stroke="#3b82f6" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="92" y2="30" stroke="url(#sheelbi-blue-purple)" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="80" y2="90" stroke="#8b5cf6" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="6" y2="44" stroke="#f59e0b" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="22" y2="88" stroke="#c87820" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="50" y2="94" stroke="#10b981" stroke-width="15" stroke-linecap="round"/><circle cx="50" cy="52" r="10" fill="#0f1419"/><circle cx="50" cy="52" r="6.5" fill="#f59e0b"/></svg></div></div><h2>নতুন চ্যাট শুরু করো 👋</h2><p class="welcome-sub">আমি তোমার <strong style="color:var(--blue)">দীপ্তি আপু</strong> — তোমার AI টিউটর।<br>বাংলা বা English যেকোনো ভাষায় প্রশ্ন করো!</p>`;
  chatBox.appendChild(welcome);
  input.value='';
  input.focus();
}

function openChat(prefillText){
  currentView='chat';
  homeView.style.display='none';
  chatView.classList.add('active');
  document.getElementById('nav-home')?.classList.remove('active');
  document.getElementById('nav-chats')?.classList.add('active');
  closeSidebar();
  if(prefillText){
    input.value=prefillText;
    autoResize(input);
    setTimeout(()=>{sendMessage();},100);
  } else {
    setTimeout(()=>input.focus(),100);
  }
}

function setMobNav(id){
  document.querySelectorAll('.mob-nav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById(id)?.classList.add('active');
}

// ═══════════════════════════════════════════════
// COUNTDOWN
// ═══════════════════════════════════════════════
function updateCounts(){
  const examDate=new Date('2026-02-13');
  const today=new Date();
  const diff=Math.ceil((examDate-today)/(1000*60*60*24));
  const el=document.getElementById('exam-days');
  const ssc=document.getElementById('ssc-days');
  if(el) el.textContent=diff>0?diff:'🎉';
  if(ssc) ssc.textContent=diff>0?diff:'Done!';
}
updateCounts();

// ═══════════════════════════════════════════════
// FOLDERS
// ═══════════════════════════════════════════════
const FOLDER_STORAGE_KEY='sheelbi_folders_v1';
const DEFAULT_FOLDERS=[];
let folders=loadFolders();
let activeFolderId=null;

function loadFolders(){
  try{const raw=localStorage.getItem(FOLDER_STORAGE_KEY);if(raw)return JSON.parse(raw);}catch(e){}
  return [];
}
function saveFolders(){try{localStorage.setItem(FOLDER_STORAGE_KEY,JSON.stringify(folders));}catch(e){}}

function renderFolders(){
  const list=document.getElementById('folders-list');
  list.innerHTML='';
  folders.forEach(f=>{
    const isBuiltIn=DEFAULT_FOLDERS.some(d=>d.id===f.id);
    const item=document.createElement('div');
    item.className='folder-item'+(f.id===activeFolderId?' active':'');
    item.dataset.folderId=f.id;
    item.innerHTML=`<span class="folder-icon">${f.icon}</span><span class="folder-name">${escapeHtml(f.name)}</span><span class="folder-count">${f.count||0}</span>${!isBuiltIn?`<button class="folder-delete-btn" onclick="deleteFolder(event,'${f.id}')" title="Delete">✕</button>`:''}`;
    item.addEventListener('click',e=>{if(e.target.classList.contains('folder-delete-btn'))return;activeFolderId=f.id;renderFolders();openChat();});
    list.appendChild(item);
  });
}
function showFolderInput(){const row=document.getElementById('folder-input-row');row.classList.add('visible');setTimeout(()=>document.getElementById('folder-name-input').focus(),50);}
function hideFolderInput(){document.getElementById('folder-input-row').classList.remove('visible');document.getElementById('folder-name-input').value='';}
function folderInputKey(e){if(e.key==='Enter')confirmNewFolder();if(e.key==='Escape')hideFolderInput();}
function confirmNewFolder(){
  const nameEl=document.getElementById('folder-name-input');
  const name=nameEl.value.trim();if(!name)return;
  const icons={math:'🔢',গণিত:'🔢',science:'🔬',বিজ্ঞান:'🔬',english:'🔤',chemistry:'⚗️',রসায়ন:'⚗️',physics:'💡',পদার্থ:'💡',history:'🗺️',biology:'🌿'};
  let icon='📁';const lower=name.toLowerCase();
  for(const[k,v]of Object.entries(icons)){if(lower.includes(k)){icon=v;break;}}
  folders.push({id:'folder_'+Date.now(),name,icon,count:0});
  saveFolders();renderFolders();hideFolderInput();
}
function deleteFolder(e,folderId){e.stopPropagation();folders=folders.filter(f=>f.id!==folderId);saveFolders();if(activeFolderId===folderId)activeFolderId=null;renderFolders();}

// ═══════════════════════════════════════════════
// FLASHCARDS
// ═══════════════════════════════════════════════
function detectTopic(text){
  const lower=text.toLowerCase();
  const topicMap=[[['সালোকসংশ্লেষণ','photosynthesis','chlorophyll'],'সালোকসংশ্লেষণ'],[['দ্বিঘাত','quadratic','সমীকরণ'],'দ্বিঘাত সমীকরণ'],[['পিথাগোরাস','pythagoras','triangle'],'পিথাগোরাস'],[['osmosis','অসমোসিস'],'Osmosis'],[['newton','নিউটন','গতিসূত্র'],'নিউটনের সূত্র'],[['এসিড','acid','ক্ষার','base'],'Acid & Base'],[['বিদ্যুৎ','electricity','current'],'বিদ্যুৎ'],[['রাসায়নিক','chemical','reaction'],'রাসায়নিক বিক্রিয়া'],[['ত্রিকোণমিতি','trigonometry','sin','cos','tan'],'ত্রিকোণমিতি'],[['cell','কোষ','nucleus'],'জীবকোষ']];
  for(const[keys,label]of topicMap){if(keys.some(k=>lower.includes(k)))return label;}
  const words=text.replace(/[^\w\u0980-\u09FF\s]/g,'').split(/\s+/).filter(w=>w.length>3);
  return words.slice(0,3).join(' ')||'এই বিষয়';
}
function parseFlashcardsFromText(rawText,topic){
  const cards=[];
  const defPattern=/\*\*([^*]+)\*\*[:\s]+(.+)/;
  const colonPattern=/^[•\-\*]?\s*([^:：]+)[：:]\s*(.+)/;
  rawText.split('\n').forEach(line=>{
    line=line.trim();if(!line||line.length<5)return;
    const clean=line.replace(/^[#\-\*•\d\.]+\s*/,'').trim();if(!clean)return;
    const defMatch=line.match(defPattern);
    if(defMatch&&defMatch[1].length<80&&defMatch[2].length<200){cards.push({q:defMatch[1].trim(),a:defMatch[2].trim()});return;}
    const colonMatch=clean.match(colonPattern);
    if(colonMatch&&colonMatch[1].length<80&&colonMatch[2].length>5)cards.push({q:colonMatch[1].trim()+'?',a:colonMatch[2].trim()});
  });
  if(cards.length<4){
    const sentences=rawText.replace(/\*\*/g,'').replace(/#{1,6}\s/g,'').split(/[।\.!?]+/).map(s=>s.trim()).filter(s=>s.length>20&&s.length<200);
    for(let j=0;j<sentences.length-1&&cards.length<10;j++){const s=sentences[j];const q=makeQuestion(s,topic);if(q&&s)cards.push({q,a:s});}
  }
  const seen=new Set();
  return cards.filter(c=>{const key=c.q.slice(0,30);if(seen.has(key))return false;seen.add(key);return true;}).slice(0,10);
}
function makeQuestion(sentence,topic){const s=sentence.trim();if(/কী|কি|কেন|কিভাবে|কখন|কোথায়/.test(s))return s+'?';const words=s.split(/[\s,]+/);if(words.length>3)return topic+' সম্পর্কে একটি গুরুত্বপূর্ণ তথ্য কী?';return null;}
function generateFallbackCards(topic){return[{q:`${topic} কী?`,a:'সংজ্ঞা জানতে Deepti-কে জিজ্ঞেস করো!'},{q:`${topic}-এর মূল বৈশিষ্ট্য কী?`,a:'বিস্তারিত জানতে প্রশ্ন করো!'},{q:`${topic} কোথায় ব্যবহার হয়?`,a:'উদাহরণ জানতে প্রশ্ন করো!'}];}
function showFlashcardGenerating(topic){const container=document.getElementById('flashcard-container');const label=document.getElementById('fc-topic-label');if(label)label.textContent=topic;container.innerHTML=`<div class="fc-generating"><div class="fc-gen-spinner"></div><div class="fc-gen-text">Flashcards তৈরি হচ্ছে...</div></div>`;}
function renderFlashcards(cards,topic){flashcardData=cards;flashcardIdx=0;const container=document.getElementById('flashcard-container');const label=document.getElementById('fc-topic-label');if(label)label.textContent=topic;if(!cards||!cards.length){container.innerHTML=`<div class="flashcard-empty"><div class="flashcard-empty-icon">🃏</div>Could not generate cards.</div>`;return;}renderSingleCard(container);}
function renderSingleCard(container){const card=flashcardData[flashcardIdx];if(!card)return;container.innerHTML=`<div class="fc-card" id="fc-current" onclick="flipCard(this)" title="Click to flip"><div class="fc-front"><div class="fc-label">Question</div><div class="fc-text">${escapeHtml(card.q)}</div><div class="fc-hint">tap to reveal ›</div></div><div class="fc-back"><div class="fc-label">Answer</div><div class="fc-text">${escapeHtml(card.a)}</div><div class="fc-hint">tap to flip back</div></div></div><div class="fc-controls"><button class="fc-nav-btn" onclick="fcNav(-1)" ${flashcardIdx===0?'disabled':''}>‹ Prev</button><span class="fc-progress-text">${flashcardIdx+1} / ${flashcardData.length}</span><button class="fc-nav-btn" onclick="fcNav(1)" ${flashcardIdx===flashcardData.length-1?'disabled':''}>Next ›</button></div>`;}
function flipCard(el){el.classList.toggle('flipped');}
function fcNav(dir){flashcardIdx=Math.max(0,Math.min(flashcardData.length-1,flashcardIdx+dir));const container=document.getElementById('flashcard-container');renderSingleCard(container);}
function updateFlashcardsFromReply(botText){if(fcGenerating)return;fcGenerating=true;const topic=detectTopic(botText);showFlashcardGenerating(topic);setTimeout(()=>{let cards=parseFlashcardsFromText(botText,topic);if(cards.length<3)cards=[...cards,...generateFallbackCards(topic)].slice(0,8);renderFlashcards(cards,topic);fcGenerating=false;},700);}

// ═══════════════════════════════════════════════
// SIDEBAR & UI
// ═══════════════════════════════════════════════
function toggleSidebar(){if(sidebarOpen)closeSidebar();else openSidebar();}
function openSidebar(){sidebarOpen=true;sidebar.classList.add('open');sidebarOverlay.classList.add('visible');document.getElementById('hamburger-btn')?.classList.add('active');closeSidebarMenu();}
function closeSidebar(){sidebarOpen=false;sidebar.classList.remove('open');sidebarOverlay.classList.remove('visible');document.getElementById('hamburger-btn')?.classList.remove('active');closeSidebarMenu();}
function toggleSidebarMenu(){if(sidebarMenuOpen)closeSidebarMenu();else openSidebarMenu();}
function openSidebarMenu(){sidebarMenuOpen=true;document.getElementById('sidebar-profile-menu').classList.add('open');document.getElementById('sidebar-profile-btn').classList.add('open');}
function closeSidebarMenu(){sidebarMenuOpen=false;document.getElementById('sidebar-profile-menu')?.classList.remove('open');document.getElementById('sidebar-profile-btn')?.classList.remove('open');}
function toggleSidebarMinimize(){
  const sb=document.getElementById('sidebar');
  const btn=document.getElementById('sidebar-minimize-btn');
  if(sb.classList.contains('minimized')){
    sb.classList.remove('minimized');
    btn.textContent='◄';
    btn.title='Collapse sidebar';
    localStorage.setItem('sidebar_minimized','false');
  } else {
    sb.classList.add('minimized');
    btn.textContent='►';
    btn.title='Expand sidebar';
    localStorage.setItem('sidebar_minimized','true');
  }
}
function filterChats(q){q=q.toLowerCase();document.querySelectorAll('.chat-item').forEach(el=>{const title=el.querySelector('.chat-item-title')?.textContent.toLowerCase()||'';el.style.display=title.includes(q)?'':''});}
function toggleTheme(){isDark=!isDark;document.documentElement.setAttribute('data-theme',isDark?'dark':'light');document.getElementById('theme-btn').textContent=isDark?'☀️':'🌙';}
function autoResize(el){el.style.height='auto';el.style.height=Math.min(el.scrollHeight,120)+'px';}
function updateCharCount(el){const n=el.value.length;document.getElementById('char-count').textContent=n>30?n+' অক্ষর':'';}
function handleKey(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendMessage();}}
function toggleQuickPanel(){quickPanel.classList.toggle('open');quickBtn.classList.toggle('open');}
function useQuick(btn){input.value=btn.textContent;autoResize(input);quickPanel.classList.remove('open');quickBtn.classList.remove('open');input.focus();}
function setInstructorTyping(isTyping){const dot=document.getElementById('status-dot');if(!dot)return;if(statusResetTimer){clearTimeout(statusResetTimer);statusResetTimer=null;}if(isTyping){dot.style.background='var(--amber)';dot.style.boxShadow='0 0 5px var(--amber)';dot.style.animation='pulse-fast .8s ease-in-out infinite';}else{dot.style.background='var(--green)';dot.style.boxShadow='0 0 5px var(--green)';dot.style.animation='pulse-dot 2.5s ease-in-out infinite';}}
function checkConfirmMatch(){const bar=document.getElementById('confirm-strength-bar');if(!bar)return;const pwd=document.getElementById('new-password')?.value||'';const confirm=document.getElementById('confirm-password')?.value||'';if(!confirm){bar.style.width='0%';return;}bar.style.width='100%';bar.style.background=pwd===confirm?'var(--green)':'var(--danger)';}
function checkPasswordStrength(pwd){const bar=document.getElementById('strength-bar');if(!bar)return;let score=0;if(pwd.length>=6)score++;if(pwd.length>=10)score++;if(/[A-Z]/.test(pwd))score++;if(/[0-9]/.test(pwd))score++;if(/[^A-Za-z0-9]/.test(pwd))score++;const colors=['var(--danger)','#f0a030','#f0a030','var(--green)','var(--green)'];bar.style.width=(score*20)+'%';bar.style.background=colors[score-1]||'var(--border2)';}

document.addEventListener('click',e=>{
  if(!quickBtn.contains(e.target)&&!quickPanel.contains(e.target)){quickPanel.classList.remove('open');quickBtn.classList.remove('open');}
  const profileBtn=document.getElementById('sidebar-profile-btn');const profileMenu=document.getElementById('sidebar-profile-menu');
  if(profileBtn&&profileMenu&&!profileBtn.contains(e.target)&&!profileMenu.contains(e.target))closeSidebarMenu();
});
document.addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&e.key==='k'){e.preventDefault();openChat();}
  if((e.ctrlKey||e.metaKey)&&e.key==='/'){e.preventDefault();toggleQuickPanel();}
  if(e.key==='Escape'){closeSidebarMenu();if(sidebarOpen)closeSidebar();tryDismissLogin();forgotOverlay.classList.remove('active');}
});
if('visualViewport' in window){window.visualViewport.addEventListener('resize',()=>{setTimeout(()=>{const ia=document.getElementById('input-area');if(ia)ia.scrollIntoView({block:'end'});},100);});}
chatBox.addEventListener('scroll',()=>{const atBottom=chatBox.scrollHeight-chatBox.scrollTop-chatBox.clientHeight<120;scrollBtn.classList.toggle('visible',!atBottom&&chatBox.scrollHeight>chatBox.clientHeight+200);});
function scrollToBottom(){chatBox.scrollTop=chatBox.scrollHeight;}

// ═══════════════════════════════════════════════
// AUTH
// ═══════════════════════════════════════════════
function getInitials(name){if(!name)return'?';return name.trim().split(/\s+/).map(w=>w[0].toUpperCase()).slice(0,2).join('');}
async function checkLoginState(){
  try{
    const res=await fetch('/me');const data=await res.json();
    const loginBtn=document.getElementById('header-login-btn');
    const profileBtn=document.getElementById('sidebar-profile-btn');
    if(data.logged_in){
      if(loginBtn)loginBtn.style.display='none';
      const initials=getInitials(data.name);
      if(profileBtn)profileBtn.style.display='flex';
      const avatarEl=document.getElementById('sb-user-avatar');const nameEl=document.getElementById('sb-user-name');const planEl=document.getElementById('sb-plan-badge');
      if(avatarEl)avatarEl.textContent=initials;if(nameEl)nameEl.textContent=data.name||'User';
      if(planEl){planEl.textContent=data.plan==='pro'?'⭐ Pro':'Free';planEl.classList.toggle('pro',data.plan==='pro');}
      document.getElementById('sidebar-initials').textContent=initials;document.getElementById('sidebar-profile-name').textContent=data.name||'User';document.getElementById('sidebar-profile-email').textContent=data.email||'';
      document.getElementById('spm-initials').textContent=initials;document.getElementById('spm-name').textContent=data.name||'User';document.getElementById('spm-email').textContent=data.email||'';
      const badge=document.getElementById('spm-plan-badge-menu');if(badge){if(data.plan==='pro'){badge.textContent='⭐ Pro';badge.classList.add('pro');}else{badge.textContent='Free';badge.classList.remove('pro');}}
      // Update greeting
      const greetingEl=document.getElementById('greeting-title');if(greetingEl&&data.name){const first=data.name.split(' ')[0];greetingEl.textContent=`আসসালামু আলাইকুম ${first}! গতকাল Trigonometry-তে তুমি 62% পেরেছিলে। আজ মাত্র ১৫ মিনিট এটা ঠিক করে নিই — রেডি?`;}
      loadChatList();
    } else {
      if(loginBtn)loginBtn.style.display='block';if(profileBtn)profileBtn.style.display='none';
      if(data.needs_verification&&data.email)showVerifyScreen(data.email);
    }
  }catch(e){}
}
async function handleLogout(){closeSidebarMenu();closeSidebar();try{await fetch('/logout',{method:'POST'});}catch(e){}localStorage.removeItem('sheelbi_chat_history_v1');sessionStorage.removeItem('guest_msg_count');window.location.href='/';}
function showLoginPrompt(isLimitReached=true){
  const title=document.getElementById('login-modal-title');const sub=document.getElementById('login-modal-sub');const card=document.getElementById('login-card');
  if(isLimitReached){title.innerHTML=`You've used your <span>5 free messages!</span>`;sub.innerHTML=`Login to keep chatting — completely free forever.<br><strong>10 questions/day</strong> at no cost.`;}
  else{title.innerHTML=`Welcome to <span>Sheelbi!</span>`;sub.innerHTML=`Login or create a free account to start chatting.<br><strong>10 questions/day</strong> at no cost.`;}
  card.classList.add('dismissible');loginOverlay.classList.add('active');
  setTimeout(()=>document.getElementById('card-email')?.focus(),350);
}
function tryDismissLogin(){const card=document.getElementById('login-card');if(card.classList.contains('dismissible'))hideLoginPrompt();}
function hideLoginPrompt(){loginOverlay.classList.remove('active');clearCardMessages();}
function switchCardTab(tab){cardTab=tab;document.querySelectorAll('.login-tab').forEach((t,i)=>{t.classList.toggle('active',(i===0&&tab==='login')||(i===1&&tab==='register'));});document.getElementById('card-name-field').style.display=tab==='register'?'block':'none';document.getElementById('card-submit').textContent=tab==='login'?'Login':'Create Account';document.getElementById('forgot-password-link').style.display=tab==='login'?'block':'none';clearCardMessages();}
function showCardError(msg){const b=document.getElementById('card-error');b.textContent=msg;b.style.display='block';document.getElementById('card-success').style.display='none';}
function showCardSuccess(msg){const b=document.getElementById('card-success');b.textContent=msg;b.style.display='block';document.getElementById('card-error').style.display='none';}
function clearCardMessages(){document.getElementById('card-error').style.display='none';document.getElementById('card-success').style.display='none';}
async function handleCardSubmit(){clearCardMessages();const btn=document.getElementById('card-submit');const email=document.getElementById('card-email').value.trim();const password=document.getElementById('card-password').value.trim();const name=document.getElementById('card-name').value.trim();if(!email||!password){showCardError('Please enter your email and password.');return;}if(cardTab==='register'&&!name){showCardError('Please enter your name.');return;}btn.disabled=true;btn.textContent='Please wait...';const url=cardTab==='login'?'/login':'/register';const body=cardTab==='login'?{email,password}:{name,email,password};try{const res=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const data=await res.json();if(data.success){if(data.needs_verification){hideLoginPrompt();showVerifyScreen(email);}else{showCardSuccess(`Welcome back, ${data.name}! 👋`);sessionStorage.removeItem('guest_msg_count');setTimeout(()=>{hideLoginPrompt();checkLoginState();input.focus();},1200);}}else{showCardError(data.error||'Something went wrong.');}}catch(e){showCardError('Server error. Please try again.');}finally{btn.disabled=false;btn.textContent=cardTab==='login'?'Login':'Create Account';}}
loginOverlay.addEventListener('keydown',e=>{if(e.key==='Enter')handleCardSubmit();});
function showVerifyScreen(email){verifyEmail=email;verifySubmitting=false;document.getElementById('verify-email-display').textContent=email;document.getElementById('verify-error').style.display='none';document.getElementById('verify-success').style.display='none';['c1','c2','c3','c4','c5','c6'].forEach(id=>{document.getElementById(id).value='';});const btn=document.getElementById('verify-btn');btn.disabled=false;btn.textContent='Verify Email ✓';verifyOverlay.classList.add('active');setTimeout(()=>document.getElementById('c1').focus(),300);}
function hideVerifyScreen(){verifyOverlay.classList.remove('active');}
function codeInput(el,prevId,nextId){el.value=el.value.replace(/[^0-9]/g,'');if(el.value&&nextId)document.getElementById(nextId).focus();const code=['c1','c2','c3','c4','c5','c6'].map(id=>document.getElementById(id).value).join('');if(code.length===6&&!verifySubmitting)submitVerifyCode();}
function codeKey(e,el,prevId,nextId){if(e.key==='Backspace'&&!el.value&&prevId)document.getElementById(prevId).focus();if(e.key==='ArrowLeft'&&prevId)document.getElementById(prevId).focus();if(e.key==='ArrowRight'&&nextId)document.getElementById(nextId).focus();}
async function submitVerifyCode(){if(verifySubmitting)return;const code=['c1','c2','c3','c4','c5','c6'].map(id=>document.getElementById(id).value).join('');if(code.length<6)return;verifySubmitting=true;const btn=document.getElementById('verify-btn');btn.disabled=true;btn.textContent='Verifying...';document.getElementById('verify-error').style.display='none';document.getElementById('verify-success').style.display='none';try{const res=await fetch('/verify-email',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:verifyEmail,code})});const data=await res.json();if(data.success){const box=document.getElementById('verify-success');box.textContent='✓ Email verified! Welcome aboard 🎉';box.style.display='block';sessionStorage.removeItem('guest_msg_count');setTimeout(()=>{hideVerifyScreen();checkLoginState();input.focus();},1500);}else{const box=document.getElementById('verify-error');box.textContent=data.error||'Invalid code.';box.style.display='block';btn.disabled=false;btn.textContent='Verify Email ✓';verifySubmitting=false;}}catch(e){const box=document.getElementById('verify-error');box.textContent='Server error.';box.style.display='block';btn.disabled=false;btn.textContent='Verify Email ✓';verifySubmitting=false;}}
async function resendCode(){const btn=document.getElementById('resend-btn');btn.disabled=true;btn.textContent='Sending...';try{const res=await fetch('/resend-verification',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:verifyEmail})});const data=await res.json();if(data.success){verifySubmitting=false;const vBtn=document.getElementById('verify-btn');vBtn.disabled=false;vBtn.textContent='Verify Email ✓';btn.textContent='✓ Sent!';setTimeout(()=>{btn.disabled=false;btn.textContent='Resend code';},3000);}else{btn.textContent='Failed';setTimeout(()=>{btn.disabled=false;btn.textContent='Resend code';},2000);}}catch(e){btn.disabled=false;btn.textContent='Resend code';}}
function showForgotPassword(){hideLoginPrompt();showForgotStep1();['forgot-email','new-password','confirm-password'].forEach(id=>{const el=document.getElementById(id);if(el)el.value='';});['r1','r2','r3','r4','r5','r6'].forEach(id=>document.getElementById(id).value='');['forgot-error','forgot-success','reset-error','reset-success'].forEach(id=>{const el=document.getElementById(id);if(el)el.style.display='none';});const bar=document.getElementById('strength-bar');if(bar)bar.style.width='0%';resetEmail='';forgotOverlay.classList.add('active');setTimeout(()=>document.getElementById('forgot-email').focus(),300);}
function hideForgotPassword(){forgotOverlay.classList.remove('active');showLoginPrompt(false);}
function showForgotStep1(){document.getElementById('forgot-step-1').style.display='block';document.getElementById('forgot-step-2').style.display='none';}
function showForgotStep2(){resetEmail=document.getElementById('forgot-email').value.trim().toLowerCase();resetSubmitting=false;document.getElementById('forgot-email-display').textContent=resetEmail;document.getElementById('forgot-step-1').style.display='none';document.getElementById('forgot-step-2').style.display='block';const btn=document.getElementById('reset-btn');btn.disabled=false;btn.textContent='Reset Password';setTimeout(()=>document.getElementById('r1').focus(),200);}
async function sendResetCode(){const email=document.getElementById('forgot-email').value.trim();if(!email){document.getElementById('forgot-error').textContent='Please enter your email.';document.getElementById('forgot-error').style.display='block';return;}document.getElementById('forgot-error').style.display='none';document.getElementById('forgot-success').style.display='none';const btn=document.getElementById('forgot-send-btn');btn.disabled=true;btn.textContent='Sending...';try{const res=await fetch('/forgot-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email})});const data=await res.json();if(data.success){showForgotStep2();}else{document.getElementById('forgot-error').textContent=data.error||'Something went wrong.';document.getElementById('forgot-error').style.display='block';}}catch(e){document.getElementById('forgot-error').textContent='Server error.';document.getElementById('forgot-error').style.display='block';}finally{btn.disabled=false;btn.textContent='Send Reset Code';}}
function resetCodeInput(el,prevId,nextId){el.value=el.value.replace(/[^0-9]/g,'');if(el.value&&nextId)document.getElementById(nextId).focus();}
function resetCodeKey(e,el,prevId,nextId){if(e.key==='Backspace'&&!el.value&&prevId)document.getElementById(prevId).focus();if(e.key==='ArrowLeft'&&prevId)document.getElementById(prevId).focus();if(e.key==='ArrowRight'&&nextId)document.getElementById(nextId).focus();}
async function submitResetPassword(){if(resetSubmitting)return;const code=['r1','r2','r3','r4','r5','r6'].map(id=>document.getElementById(id).value).join('');const newPassword=document.getElementById('new-password').value.trim();const confirmPwd=document.getElementById('confirm-password').value.trim();document.getElementById('reset-error').style.display='none';document.getElementById('reset-success').style.display='none';if(code.length<6){document.getElementById('reset-error').textContent='Please enter the full 6-digit code.';document.getElementById('reset-error').style.display='block';return;}if(!newPassword||newPassword.length<6){document.getElementById('reset-error').textContent='Password must be at least 6 characters.';document.getElementById('reset-error').style.display='block';return;}if(newPassword!==confirmPwd){document.getElementById('reset-error').textContent='Passwords do not match.';document.getElementById('reset-error').style.display='block';return;}resetSubmitting=true;const btn=document.getElementById('reset-btn');btn.disabled=true;btn.textContent='Resetting...';try{const res=await fetch('/reset-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:resetEmail,code,new_password:newPassword})});const data=await res.json();if(data.success){const box=document.getElementById('reset-success');box.textContent='✓ Password reset! You can now log in.';box.style.display='block';setTimeout(()=>{forgotOverlay.classList.remove('active');showLoginPrompt(false);},2000);}else{document.getElementById('reset-error').textContent=data.error||'Something went wrong.';document.getElementById('reset-error').style.display='block';resetSubmitting=false;}}catch(e){document.getElementById('reset-error').textContent='Server error.';document.getElementById('reset-error').style.display='block';resetSubmitting=false;}finally{btn.disabled=false;btn.textContent='Reset Password';}}

// ═══════════════════════════════════════════════
// HISTORY
// ═══════════════════════════════════════════════
const STORAGE_KEY='sheelbi_chat_history_v1';
function saveHistory(){try{const allMsgs=[];chatBox.querySelectorAll('.message').forEach(div=>{const role=div.classList.contains('user')?'user':'bot';const bt=div.querySelector('.bubble-text');const b=div.querySelector('.bubble:not(.thinking-bubble)');if(role==='user'&&bt)allMsgs.push({role,html:bt.textContent,type:'text'});else if(role==='bot'&&b&&!b.querySelector('.thinking-label'))allMsgs.push({role,html:b.innerHTML,type:'html'});});localStorage.setItem(STORAGE_KEY,JSON.stringify(allMsgs.slice(-40)));}catch(e){}}
function loadHistory(){try{const raw=localStorage.getItem(STORAGE_KEY);if(!raw)return;const msgs=JSON.parse(raw);if(!msgs.length)return;document.getElementById('welcome-screen')?.remove();msgs.forEach(m=>{if(m.role==='user')addUserBubble(m.html);else addBotBubble_fromStorage(m.html);});chatBox.scrollTop=chatBox.scrollHeight;}catch(e){localStorage.removeItem(STORAGE_KEY);}}
function clearHistory(){localStorage.removeItem(STORAGE_KEY);}

// ═══════════════════════════════════════════════
// CHAT LIST
// ═══════════════════════════════════════════════
function formatTimeAgo(dateStr){const date=new Date(dateStr),now=new Date();const diff=Math.floor((now-date)/1000);if(diff<60)return'just now';if(diff<3600)return Math.floor(diff/60)+'m ago';if(diff<86400)return Math.floor(diff/3600)+'h ago';if(diff<86400*7)return Math.floor(diff/86400)+'d ago';return date.toLocaleDateString('en-BD',{month:'short',day:'numeric'});}
async function loadChatList(){try{const res=await fetch('/chats');if(!res.ok)return;const data=await res.json();allChats=data.chats||[];renderChatList(allChats);}catch(e){}}
function getSubjectIcon(title){const t=title.toLowerCase();if(/গণিত|math|algebra|সমীকরণ/.test(t))return'🔢';if(/বিজ্ঞান|science|physics|পদার্থ/.test(t))return'🔬';if(/রসায়ন|chemistry|acid/.test(t))return'⚗️';if(/বাংলা|literature|কবিতা/.test(t))return'📚';if(/ইতিহাস|history/.test(t))return'🗺️';if(/ছবি|image|photo/.test(t))return'📷';if(/english/.test(t))return'🔤';return'💬';}
function renderChatList(chats){
  // Update sidebar chat items if they exist — skip for now since sidebar doesn't have separate chat list area
}
function escapeHtml(s){if(!s)return'';return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
async function loadChat(chatId){try{const res=await fetch('/chats/'+chatId);if(!res.ok)return;const data=await res.json();const chat=data.chat;currentChatId=chatId;document.getElementById('welcome-screen')?.remove();chatBox.querySelectorAll('.message').forEach(el=>el.remove());(chat.messages||[]).forEach(m=>{if(m.role==='user')addUserBubble(m.content);else addBotBubble_fromStorage(m.content);});openChat();chatBox.scrollTop=chatBox.scrollHeight;}catch(e){}}
async function deleteChat(e,chatId){e.stopPropagation();try{await fetch('/chats/'+chatId,{method:'DELETE'});if(chatId===currentChatId){currentChatId=null;}loadChatList();}catch(e){}}

// ═══════════════════════════════════════════════
// MATH
// ═══════════════════════════════════════════════
function isBengali(cp){return cp>=0x0980&&cp<=0x09FF;}
const SUP={'0':'⁰','1':'¹','2':'²','3':'³','4':'⁴','5':'⁵','6':'⁶','7':'⁷','8':'⁸','9':'⁹','n':'ⁿ','x':'ˣ','a':'ᵃ','b':'ᵇ','i':'ⁱ'};
const SUB={'0':'₀','1':'₁','2':'₂','3':'₃','4':'₄','5':'₅','6':'₆','7':'₇','8':'₈','9':'₉','n':'ₙ','i':'ᵢ'};
const toSup=s=>s.split('').map(c=>SUP[c]||c).join('');
const toSub=s=>s.split('').map(c=>SUB[c]||c).join('');
function latexToPlain(s){return s.replace(/\\rightarrow|\\to/g,'→').replace(/\\leftarrow/g,'←').replace(/\\times/g,'×').replace(/\\cdot/g,'·').replace(/\\pm/g,'±').replace(/\\neq/g,'≠').replace(/\\leq/g,'≤').replace(/\\geq/g,'≥').replace(/\\frac\{([^}]+)\}\{([^}]+)\}/g,'($1)/($2)').replace(/\\sqrt\{([^}]+)\}/g,'√($1)').replace(/\\left\s*[([\{]/g,'(').replace(/\\right\s*[)\]}\}]/g,')').replace(/\{([^}]*)\}/g,'$1').replace(/_\{([^}]+)\}/g,(_,s)=>toSub(s)).replace(/_([0-9a-zn])/g,(_,s)=>toSub(s)).replace(/\^\{([^}]+)\}/g,(_,s)=>toSup(s)).replace(/\^([0-9a-zn])/g,(_,s)=>toSup(s)).replace(/\\[a-zA-Z]+/g,'').replace(/\s+/g,' ').trim();}
function hasLatex(s){return/\\(?:frac|sqrt|left|right|cdot|times|pm|rightarrow|leftarrow|leq|geq|neq|alpha|beta|theta|pi|sigma|delta|lambda|mu|infty|sum|int|prod|lim|log|sin|cos|tan)\b/.test(s)||/[a-zA-Z]\^[{0-9]/.test(s)||/[a-zA-Z]_[{0-9]/.test(s);}
function preSplit(text){text=text.replace(/(।)\s*(?=[a-zA-Z\\(])/g,'$1\n');text=text.replace(/([.!?])\s*(?=[\u0980-\u09FF])/g,'$1\n');text=text.replace(/(\))\s*(?=[\u0980-\u09FF])/g,'$1\n');text=text.replace(/([\u0980-\u09FF])\s*([a-zA-Z]\^)/g,'$1\n$2');return text;}
function processLine(line){if(/^\s*\$\$[^$]+\$\$\s*$/.test(line))return line;if(/^\s*\$[^$]+\$\s*$/.test(line)&&!hasLatex(line.replace(/\$[^$]+\$/g,'')))return line;const hasBn=/[\u0980-\u09FF]/.test(line),hasLx=hasLatex(line);if(!hasLx)return line;if(!hasBn){if(!/\$/.test(line))return'$$'+line.trim()+'$$';return line;}return smartTokenize(line);}
function smartTokenize(line){const segments=[];let i=0,buf='',mode='text';while(i<line.length){if(line[i]==='$'&&line[i+1]==='$'){if(buf.trim())segments.push({type:mode,content:buf});buf='';mode='text';const close=line.indexOf('$$',i+2);if(close!==-1){segments.push({type:'delimited',content:line.slice(i,close+2)});i=close+2;continue;}}if(line[i]==='$'&&line[i+1]!=='$'){if(buf.trim())segments.push({type:mode,content:buf});buf='';mode='text';const close=line.indexOf('$',i+1);if(close!==-1){segments.push({type:'delimited',content:line.slice(i,close+1)});i=close+1;continue;}}const cp=line.codePointAt(i),ch=line[i];const isBn=isBengali(cp),isBnPunct='।,!? '.includes(ch)&&mode==='text',isLatexStart=ch==='\\';if(isBn||isBnPunct){if(mode==='math'&&buf.trim()){segments.push({type:'math',content:buf.trim()});buf='';}mode='text';buf+=ch;i++;}else if(isLatexStart){if(mode==='text'&&buf.trim()){segments.push({type:'text',content:buf.trim()});buf='';}mode='math';buf+=ch;i++;}else{if(mode==='text'&&/[a-zA-Z]/.test(ch)){const ahead=line.slice(i+1).trimStart();if(/^[^a-zA-Z\u0980-\u09FF]{0,3}[\^_=+\-*\/\\]/.test(ahead)&&!isBengali(line.codePointAt(i+1)||0)){if(buf.trim())segments.push({type:'text',content:buf.trim()});buf='';mode='math';}}buf+=ch;i++;}}if(buf.trim())segments.push({type:mode,content:buf.trim()});const parts=[];for(const seg of segments){if(seg.type==='delimited'){parts.push(seg.content);continue;}if(seg.type==='text'){parts.push(seg.content);continue;}const t=seg.content.trim();if(!t)continue;if(/[\u0980-\u09FF]/.test(t)){parts.push(latexToPlain(t));continue;}const isComplex=t.length>25||/\\frac|\\sqrt|\\sum|\\int/.test(t);parts.push(isComplex?'\n$$'+t+'$$\n':'$'+t+'$');}return parts.join(' ').replace(/ +\n/g,'\n').replace(/\n +/g,'\n').trim();}
function fixBengaliInsideMath(text){text=text.replace(/\$\$([\s\S]*?)\$\$/g,(match,inner)=>{if(!/[\u0980-\u09FF]/.test(inner))return match;return latexToPlain(inner);});text=text.replace(/\$([^$\n]{1,300}?)\$/g,(match,inner)=>{if(!/[\u0980-\u09FF]/.test(inner))return match;if(!hasLatex(inner)&&!/[=+\-*/^_]/.test(inner))return inner.trim();return latexToPlain(inner);});return text;}
function fixDollarStructure(text){text=text.replace(/\$\$\s*\n([\s\S]*?)\n\s*\$\$/g,(_,inner)=>'$$'+inner.trim()+'$$');text=text.replace(/^([^\n$]*[\u0980-\u09FF][^\n$]*)\$\$\s*$/gm,'$1');text=text.replace(/^\$\$\s*$/gm,'');text=text.replace(/(\$\$)([\u0980-\u09FF])/g,'$1\n$2');text=text.replace(/(\$)([\u0980-\u09FF])/g,'$1 $2');return text;}
function fixLeftRight(text){text=text.replace(/\\left\s*\$/g,'\\left(');text=text.replace(/\\right\s*\$/g,'\\right)');return text;}
function fixBrackets(text){return text.replace(/\$\$([\s\S]*?)\$\$/g,(match,inner)=>{const fixed=inner.replace(/(?<!\\left)\(([^()]*(?:\\frac|\\sqrt|\\sum|\\int)[^()]*)\)(?!\\right)/g,'\\left($1\\right)');return'$$'+fixed+'$$';});}
function cleanNested(text){return text.replace(/\$\$([\s\S]*?)\$\$/g,(_,inner)=>'$$'+inner.replace(/(?<!\$)\$(?!\$)/g,'')+'$$');}
function processText(raw){let t=preSplit(raw);t=t.split('\n').map(processLine).join('\n');t=fixBengaliInsideMath(t);t=fixDollarStructure(t);t=fixLeftRight(t);t=fixBrackets(t);t=cleanNested(t);return t;}
function renderMath(el){renderMathInElement(el,{delimiters:[{left:'$$',right:'$$',display:true},{left:'$',right:'$',display:false}],throwOnError:false,trust:true});}
function addMathCopyBtns(bubble,rawText){const mathBlocks=[];const re=/\$\$([\s\S]*?)\$\$/g;let m;while((m=re.exec(rawText))!==null)mathBlocks.push(m[1].trim());bubble.querySelectorAll('.katex-display').forEach((el,i)=>{const wrap=document.createElement('div');wrap.className='math-block-wrap';el.parentNode.insertBefore(wrap,el);wrap.appendChild(el);const btn=document.createElement('button');btn.className='math-copy-btn';btn.textContent='LaTeX কপি';const latex=mathBlocks[i]||'';btn.onclick=()=>{navigator.clipboard.writeText('$$'+latex+'$$').then(()=>{btn.textContent='✓ হয়েছে';setTimeout(()=>{btn.textContent='LaTeX কপি';},1800);});};wrap.appendChild(btn);});}
function extractSuggestions(text){const lines=text.split('\n');let idx=-1;for(let i=lines.length-1;i>=0;i--){if(/^\s*\[.+\]/.test(lines[i])){idx=i;break;}}if(idx===-1)return{cleanText:text,buttons:[]};const buttons=[];const re=/\[([^\]]+)\]/g;let m2;while((m2=re.exec(lines[idx]))!==null)buttons.push(m2[1]);return{cleanText:lines.filter((_,i)=>i!==idx).join('\n').trimEnd(),buttons};}

// ═══════════════════════════════════════════════
// MESSAGES
// ═══════════════════════════════════════════════
const BOT_AVATAR_SVG=`<svg width="16" height="16" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><line x1="50" y1="52" x2="50" y2="6" stroke="#4d7fff" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="92" y2="30" stroke="#7a6fcc" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="80" y2="90" stroke="#9b6fd4" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="6" y2="44" stroke="#f0a030" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="22" y2="88" stroke="#c87820" stroke-width="15" stroke-linecap="round"/><line x1="50" y1="52" x2="50" y2="94" stroke="#22c58c" stroke-width="15" stroke-linecap="round"/><circle cx="50" cy="52" r="10" fill="#0d0f14"/><circle cx="50" cy="52" r="6.5" fill="#f0a030"/></svg>`;

function addUserBubble(text,imageDataUrl=null){document.getElementById('welcome-screen')?.remove();const div=document.createElement('div');div.className='message user';const bubble=document.createElement('div');bubble.className='bubble';if(imageDataUrl){const img=document.createElement('img');img.src=imageDataUrl;img.className='sent-image';bubble.appendChild(img);}const span=document.createElement('div');span.className='bubble-text';span.textContent=text;bubble.appendChild(span);div.innerHTML=`<div class="avatar">👤</div>`;div.appendChild(bubble);chatBox.appendChild(div);chatBox.scrollTop=chatBox.scrollHeight;}
function addBotBubble(htmlContent,fromStorage=false){document.getElementById('welcome-screen')?.remove();const div=document.createElement('div');div.className='message bot';div.innerHTML=`<div class="avatar">${BOT_AVATAR_SVG}</div>`;const col=document.createElement('div');col.className='bot-col';const bubble=document.createElement('div');bubble.className='bubble';bubble.innerHTML=htmlContent;col.appendChild(bubble);const actions=document.createElement('div');actions.className='message-actions';const copyBtn=document.createElement('button');copyBtn.className='action-btn';copyBtn.textContent='📋 কপি';copyBtn.onclick=()=>{navigator.clipboard.writeText(bubble.innerText).then(()=>{copyBtn.textContent='✓ হয়েছে';copyBtn.classList.add('ok');setTimeout(()=>{copyBtn.textContent='📋 কপি';copyBtn.classList.remove('ok');},1800);});};actions.appendChild(copyBtn);col.appendChild(actions);div.appendChild(col);chatBox.appendChild(div);chatBox.scrollTop=chatBox.scrollHeight;return bubble;}
function addBotBubble_fromStorage(content){document.getElementById('welcome-screen')?.remove();const div=document.createElement('div');div.className='message bot';div.innerHTML=`<div class="avatar">${BOT_AVATAR_SVG}</div>`;const col=document.createElement('div');col.className='bot-col';const bubble=document.createElement('div');bubble.className='bubble';const fixed=processText(content);bubble.innerHTML=marked.parse(fixed);bubble.style.lineHeight=/[\u0980-\u09FF]/.test(fixed)?'2.1':'1.85';col.appendChild(bubble);div.appendChild(col);chatBox.appendChild(div);renderMath(bubble);addMathCopyBtns(bubble,fixed);const actions=document.createElement('div');actions.className='message-actions';const copyBtn=document.createElement('button');copyBtn.className='action-btn';copyBtn.textContent='📋 কপি';copyBtn.onclick=()=>{navigator.clipboard.writeText(bubble.innerText).then(()=>{copyBtn.textContent='✓ হয়েছে';copyBtn.classList.add('ok');setTimeout(()=>{copyBtn.textContent='📋 কপি';copyBtn.classList.remove('ok');},1800);});};actions.appendChild(copyBtn);col.appendChild(actions);chatBox.scrollTop=chatBox.scrollHeight;}
function addMessage(text,role,imageDataUrl=null){document.getElementById('welcome-screen')?.remove();if(role==='user'){addUserBubble(text,imageDataUrl);return;}const{cleanText,buttons}=extractSuggestions(text);const fixed=processText(cleanText);const html=marked.parse(fixed);const bubble=addBotBubble(html);bubble.style.lineHeight=/[\u0980-\u09FF]/.test(fixed)?'2.1':'1.85';renderMath(bubble);addMathCopyBtns(bubble,fixed);if(buttons.length>0){const row=document.createElement('div');row.className='ai-suggestions';buttons.forEach(label=>{const btn=document.createElement('button');btn.className='ai-suggestion-btn';btn.textContent=label;btn.onclick=()=>{input.value=label;sendMessage();};row.appendChild(btn);});bubble.appendChild(row);}const qCount=document.getElementById('rs-question-count');const qRemain=document.getElementById('rs-remaining');if(qCount){const n=parseInt(qCount.textContent||'0')+1;qCount.textContent=n;if(qRemain)qRemain.textContent=Math.max(0,10-n)+' remaining today';}const statQ=document.getElementById('stat-q-today');if(statQ)statQ.textContent=parseInt(statQ.textContent||'0')+1;updateFlashcardsFromReply(text);saveHistory();}
function addErrorMessage(msg,retryFn){const div=document.createElement('div');div.className='message bot';div.innerHTML=`<div class="avatar">${BOT_AVATAR_SVG}</div>`;const col=document.createElement('div');col.className='bot-col';const err=document.createElement('div');err.className='error-bubble';err.innerHTML=`<span>⚠️ ${msg}</span>`;if(retryFn){const btn=document.createElement('button');btn.className='action-btn';btn.textContent='🔄 আবার চেষ্টা';btn.onclick=()=>{div.remove();retryFn();};err.appendChild(btn);}col.appendChild(err);div.appendChild(col);chatBox.appendChild(div);chatBox.scrollTop=chatBox.scrollHeight;}

const thinkingPhrases=['উত্তর তৈরি হচ্ছে...','চিন্তা করছি...','হিসাব করছি...','লিখছি...','একটু ভাবছি...'];
let thinkingTimer=null;
function showTyping(){document.getElementById('welcome-screen')?.remove();const div=document.createElement('div');div.className='message bot';div.id='typing-indicator';div.innerHTML=`<div class="avatar">${BOT_AVATAR_SVG}</div><div class="bot-col"><div class="bubble thinking-bubble"><div class="thinking-label"><div class="thinking-spinner"></div><span id="thinking-text">ভাবছি...</span></div><div class="thinking-dots"><span></span><span></span><span></span></div></div></div>`;chatBox.appendChild(div);chatBox.scrollTop=chatBox.scrollHeight;let i=0;thinkingTimer=setInterval(()=>{const el=document.getElementById('thinking-text');if(el){i=(i+1)%thinkingPhrases.length;el.textContent=thinkingPhrases[i];}},1800);}
function removeTyping(){if(thinkingTimer){clearInterval(thinkingTimer);thinkingTimer=null;}document.getElementById('typing-indicator')?.remove();}
function sendSuggestion(cardEl){const q=cardEl.dataset?.q||cardEl.textContent;input.value=q;sendMessage();}

// ═══════════════════════════════════════════════
// SEND
// ═══════════════════════════════════════════════
async function sendMessage(){
  const text=input.value.trim();
  if(!text&&!selectedFile)return;
  const displayText=text||'(ছবি পাঠানো হয়েছে)';
  const imageSnapshot=selectedFile?URL.createObjectURL(selectedFile):null;
  const fileSnapshot=selectedFile;
  input.value='';input.style.height='auto';sendBtn.disabled=true;
  document.getElementById('char-count').textContent='';
  openChat();
  addMessage(displayText,'user',imageSnapshot);
  showTyping();setInstructorTyping(true);
  setTimeout(()=>chatBox.scrollTop=chatBox.scrollHeight,50);
  const doRequest=async()=>{
    try{
      let reply;
      if(fileSnapshot){
        const formData=new FormData();formData.append('image',fileSnapshot);formData.append('message',text||'এই ছবিটি দেখে বুঝিয়ে দাও।');if(currentChatId)formData.append('chat_id',currentChatId);
        const res=await fetch('/ask-image',{method:'POST',body:formData});const data=await res.json();
        if(data.login_required){removeTyping();setInstructorTyping(false);showLoginPrompt(true);return;}
        reply=data.reply||'দুঃখিত, সমস্যা হয়েছে।';if(data.chat_id){currentChatId=data.chat_id;loadChatList();}removeImage();
      }else{
        const res=await fetch('/ask',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:text,chat_id:currentChatId})});const data=await res.json();
        if(data.login_required){removeTyping();setInstructorTyping(false);showLoginPrompt(true);return;}
        reply=data.reply||'দুঃখিত, সমস্যা হয়েছে।';if(data.chat_id){currentChatId=data.chat_id;loadChatList();}
      }
      removeTyping();setInstructorTyping(false);addMessage(reply,'bot');
      setTimeout(()=>chatBox.scrollTop=chatBox.scrollHeight,100);
    }catch(err){removeTyping();setInstructorTyping(false);addErrorMessage('সংযোগে সমস্যা হয়েছে।',doRequest);}
    sendBtn.disabled=false;input.focus();
  };
  await doRequest();
}

// ═══════════════════════════════════════════════
// FILE
// ═══════════════════════════════════════════════
function handleFileSelect(e){const file=e.target.files[0];if(!file)return;selectedFile=file;const reader=new FileReader();reader.onload=ev=>{document.getElementById('preview-thumb').src=ev.target.result;};reader.readAsDataURL(file);document.getElementById('preview-name').textContent=file.name;strip.classList.add('visible');attachBtn.classList.add('has-image');input.placeholder='এই ছবি সম্পর্কে প্রশ্ন লেখো...';input.focus();}
function removeImage(){selectedFile=null;document.getElementById('file-input').value='';document.getElementById('preview-thumb').src='';document.getElementById('preview-name').textContent='';strip.classList.remove('visible');attachBtn.classList.remove('has-image');input.placeholder='বাংলা বা English এ প্রশ্ন লেখো...';}

input.addEventListener('focus',function(){setTimeout(()=>{this.scrollIntoView({behavior:'smooth',block:'nearest'});},100);});

// ═══════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════
showHome();
renderFolders();
loadHistory();
checkLoginState();
// Restore sidebar minimize state
if(localStorage.getItem('sidebar_minimized')==='true'){
  const sb=document.getElementById('sidebar');
  const btn=document.getElementById('sidebar-minimize-btn');
  sb.classList.add('minimized');
  btn.textContent='►';
  btn.title='Expand sidebar';
}
if(isGuestLimitReached())showLoginPrompt(true);
</script>
</body>
</html>